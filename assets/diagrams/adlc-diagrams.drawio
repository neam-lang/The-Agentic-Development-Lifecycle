 what the model cannot yet do for itself." style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="112.0" y="279.5" width="643.5" height="18.5" as="geometry"/></mxCell><mxCell id="c27" value="A harness that only ever grows is a fossil record of model weaknesses that may no longer exist." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="112.0" y="297.5" width="641.6" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 2.4" id="figure-2-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="257" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="WHAT SURVIVES WHEN A THIRD OF THE BENCHMARK TURNS OUT TO BE CONTAMINATED" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="446.5" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="ABSOLUTE CLAIM — a level" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="&quot;resolves 12.47% of real issues&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="32.67% solution leakage" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="31.08% weak tests" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="collapses to 3.97% when filtered" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="✗ do not cite" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="RELATIVE CLAIM — a ratio" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="&quot;9.5× the same model&#x27;s baseline&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="contamination is symmetric across arms" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="leaked instances removed from BOTH" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="the ratio is unchanged" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="✓ cite this" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="Symmetric contamination is fatal to levels and survivable by ratios. Most published agent results are levels." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="6.7" y="186.0" width="886.5" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 3.2" id="figure-3-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="252" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="34.0" width="283.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#B