ometry x="474.0" y="66.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="trust: OPERATOR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="trust: REPO MAINTAINER" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="trust: REPO (reviewed)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="trust: DERIVED (tool)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="trust: ANYONE ON THE INTERNET" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="trust: THIRD PARTY" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="Behaviour verification is blocked on eliciting information that does not exist. This is blocked on carrying" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="14.8" y="216.0" width="870.4" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="information that does." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="357.3" y="234.0" width="185.3" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 11.5" id="figure-11-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="357" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="444.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="56.0" width="444.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="132.0" width="444.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="132.0" width="444.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="208.0" width="444.0" height="64.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=27;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="208.0" width="444.0" height="64.0" as="geometry"/></mxCell><mxCell id="c7" value="ACCOUNTABILITY FOLLOWS AUTHORITY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="202.9" height="16.5" as="geometry"/></mxCell><mxCell id="c8" value="WHAT IS ACTUALLY DECIDED" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="125.0" y="31.5" width="194.0" height="18.5" as="geometry"/></mxCell><mxCell id="c9" value="WHO SHOULD OWN IT" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="608.1" y="31.5" width="139.8" height="18.5" as="geometry"/></mxCell><mxCell id="c10" value="&quot;changes of this class may run at autonomy level A3&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="70.0" width="427.1" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="the autonomy decision · Ch 13" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="70.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="an explicit, auditable, reviewable decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="469.0" y="92.8" width="287.3" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="&quot;these are the controls that gate that class&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="146.0" width="370.7" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="the harness owner · Ch 16" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="146.0" width="209.5" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="accountable for coverage, drills and retirement" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="469.0" y="168.8" width="313.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="&quot;this specific diff is correct&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="222.0" width="257.9" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="the reviewer" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="222.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="accountable only for what is genuinely reviewable at this batch size" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="469.0" y="244.8" width="449.7" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="The consequential decisions are about classes of change and the controls around them — not about individual diffs." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="289.5" width="768.4" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 12.2" id="figure-12-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="304" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=12;fillColor=#4338CA;strokeColor=none;strokeWidt