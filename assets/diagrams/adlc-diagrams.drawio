;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="295.5" width="588.3" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 1.1" id="figure-1-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="272" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="190.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="ASK WHERE THE RANDOMNESS COMES TO REST" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="239.4" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="MEANING A — Agent-SDLC" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="the agent is the PRODUCT" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="engineers build the agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="the agent serves users directly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="the dice are re-rolled on every interaction, forever" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="345.8" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="no gate can be binary — there is no last interaction" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="345.8" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="controls: perpetual runtime monitors" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="MEANING B — ADLC" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="137.0" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="the agent is the LABOUR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="engineers direct the agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="the agent produces software" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="randomness stops at the MERGE GATE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="users receive determinism" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="controls: deterministic gates + probabilistic reviewers" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="365.3" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="Same acronym. Two locations for the randomness — and therefore two different disciplines." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="87.3" y="201.0" width="725.3" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 1.2" id="figure-1-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="291" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=36;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="8.0" width="900.0" height="197.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=36;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="34.0" y="42.0" width="832.0" height="129.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=30;fillColor=#0F172A;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=94" vertex="1" parent="1"><mxGeometry x="170.0" y="94.0" width="560.0" height="65.0" as="geometry"/></mxCell><mxCell id="c4" value="ADLC (Meaning B)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="16.0" y="18.5" width="132.0" height="18.5" as="geometry"/></mxCell><mxCell id="c5" value="how this software gets built · guides · sensors · context · graph · structure · gates" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="145.0" y="19.5" width="574.9" height="17.5" as="geometry"/></mxCell><mxCell id="c6" value="the software under construction" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50.0" y="52.5" width="248.2" height="18.5" as="geometry"/></mxCell><mxCell id="c7" value="deterministic products and stochastic ones alike" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="287.0" y="53.5" width="328.2" height="17.5" as="geometry"/></mxCell><mxCell id="c8" value="AN AGENT" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#FFFFFF;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="408.8" y="106.0" width="82.4" height="21.0" as="geometry"/></mxCell><mxCell id="c9" value="Agent-SDLC adds runtime obligations here: evals · drift · red-teaming" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.6;fontColor=#FFFFFF;resizable=1" vertex="1" parent="1"><mxGeometry x="213.9" y="130.4" width="472.2" height="17.6" as="geometry"/></mxCell><mxCell id="c10" value="Meaning A is Meaning B applied to a stochastic product. The inner discipline adds runtime controls;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.4;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="214.6" width="662.6" height="17.4" as="geometry"/></mxCell><mxCell id="c11" value="it does not replace the construction-time controls of the outer one." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.4;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="231.6" width="457.6" height="17.4" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 2.1" id="figure-2-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="318" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=12;fillColor=#64748B;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="290.0" y="30.0" width="35.0" height="22.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=12;fillColor=#64748B;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="290.0" y="80.0" width="102.0" height="22.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=12;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="290.0" y="114.0" width="297.0" height="22.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="