"12.0" as="geometry"/></mxCell><mxCell id="c25" value="WHAT MATURITY BUYS — AND WHAT IT DOES NOT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="257.7" height="16.5" as="geometry"/></mxCell><mxCell id="c26" value="catch mechanical failure faster" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="257.9" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="improves" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="811.5" y="43.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c28" value="cost per accepted change" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="97.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c29" value="improves" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="811.5" y="96.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c30" value="time-to-control" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="150.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c31" value="improves" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="811.5" y="149.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c32" value="review load per change" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="203.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c33" value="improves" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="811.5" y="202.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c34" value="verify the intent was met" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="256.0" width="209.5" height="19.0" as="geometry"/></mxCell><mxCell id="c35" value="Chapter 8&#x27;s behaviour harness is unsolved at every level" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="278.8" width="371.8" height="17.2" as="geometry"/></mxCell><mxCell id="c36" value="FLAT" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="843.8" y="255.0" width="40.2" height="19.0" as="geometry"/></mxCell><mxCell id="c37" value="specification quality" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="330.0" width="177.3" height="19.0" as="geometry"/></mxCell><mxCell id="c38" value="an L4 organisation with poor specs ships well-harnessed wrong software, faster" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="352.8" width="514.7" height="17.2" as="geometry"/></mxCell><mxCell id="c39" value="FLAT" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="843.8" y="329.0" width="40.2" height="19.0" as="geometry"/></mxCell><mxCell id="c40" value="safety at severe blast radius" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="404.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c41" value="blast radius vetoes — you reduce it by changing the system, not the process" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="426.8" width="495.2" height="17.2" as="geometry"/></mxCell><mxCell id="c42" value="FLAT" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="843.8" y="403.0" width="40.2" height="19.0" as="geometry"/></mxCell><mxCell id="c43" value="human judgment" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="479.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c44" value="the mechanism that makes L4 valuable is the one that erodes the faculty it cannot replace" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="501.8" width="586.1" height="17.2" as="geometry"/></mxCell><mxCell id="c45" value="FLAT or worse" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="771.2" y="478.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c46" value="The top block is what maturity buys. The bottom block is what matters most, and none of it moves." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="539.5" width="655.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 15.4" id="figure-15-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="794" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="8.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="100.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="192.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="285.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="377.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="469.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="561.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="120.0" y="653.0" width="660.0" height="64.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="75.0" as="sourcePoint"/><mxPoint x="450.0" y="97.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="167.0" as="sourcePoint"/><mxPoint x="450.0" y="189.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="260.0" as="sourcePoint"/><mxPoint x="450.0" y="282.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="352.0" as="sourcePoint"/><mxPoint x="450.0" y="374.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="444.0" as="sourcePoint"/><mxPoint x="450.0" y="466.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="536.0" as="sourcePoint"/><mxPoint x="450.0" y="558.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="628.0" as="sourcePoint"/><mxPoint x="450.0" y="650.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="1 · Is there anything in version control that governs agent behaviour?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="22.0" width="572.2" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="no → L0" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="44.8" width="53.5" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="2 · Has it been edited more than once, by more than one person?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="114.0" width="515.8" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="no → L0/L1 boundary" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="136.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="3 · Does any check run INSIDE the edit cycle and REFUSE a bad edit?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="206.0" width="548.0" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="no → L1 · roughly 1–3% of repositories can say yes" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="228.8" width="332.8" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="4 · Are execution traces and sensor outcomes stored somewhere queryable?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="299.0" width="588.3" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="no → L1, and L3 is closed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="321.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c24" value="5 · A control installed in response to a RECURRENCE, with the prior incidents named?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="391.0" width="685.0" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="no → L2" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="413.8" width="53.5" height="17.2" as="geometry"/></mxCell><mxCell id="c26" value="6 · A control you REMOVED, with a stated reason?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="483.0" width="394.9" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="no → L2/L3 boundary · the rarest artefact in the model" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="505.8" width="358.8" height="17.2" as="geometry"/></mxCell><mxCell id="c28" value="7 · A harness template consumed by a team that did not write it?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="575.0" width="523.8" height="19.0" as="geometry"/></mxCell><mxCell id="c29" value="no → L3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="597.8" width="53.5" height="17.2" as="geometry"/></mxCell><mxCell id="c30" value="8 · Do you measure harness coverage against drills that actually fired?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="133.0" y="667.0" width="580.3" height="19.0" as="geometry"/></mxCell><mxCell id="c31" value="all yes → L4" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="133.0" y="689.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c32" value="Eight questions, all answerable from artefacts. Most readers will stop at question 3." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="155.1" y="726.2" width="589.7" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 16.1" id="figure-16-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="257" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="A STREAM-ALIGNED TEAM CONSIDERS BUILDING A SENSOR" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="306.4" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="COST — borne entirely by this team" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="a quarter of engineering time" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="an owner, forever" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="false positives, forever" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="deferred feature work" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="the team pays 100%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="BENEFIT — shared" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="137.0" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="own team ▓▓▓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="team B ░░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="73.0" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="team C ░░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="73.0" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="every future team ░░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="the team captures perhaps 20%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="RATIONAL DECISION: do not build it. And every team reaches the same conclusion — so it is never built by anyone." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-5.4" y="186.0" width="910.7" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 16.2" id="figure-16-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="360" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="442.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="458.0" y="30.0" width="442.0" height="110.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="156.0" width="442.0" height="110.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="458.0" y="156.0" width="442.0" height="110.0" as="geometry"/></mxCell><mxCell id="c5" value="FOUR TEAM TYPES, MAPPED ONTO HARNESS WORK" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="257.7" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="PLATFORM TEAM" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="owns: harness TEMPLATES, the graph pipeline, trace capture, drill" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="430.2" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="infrastructure" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="requires: a variety-reduction commitment" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="267.8" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="interaction: X-as-a-Service" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="STREAM-ALIGNED TEAMS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="471.0" y="44.0" width="169.2" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="own: their harness INSTANCE, their autonomy policy," style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="66.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="their named harness owner" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="81.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="ENABLING TEAM" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="170.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="moves a stream team from L1 → L2: wires the first blocking sensor," style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.8" width="436.7" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="stands up trace capture, then LEAVES" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="207.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="the type most organisations omit — and the one that moves the" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="222.8" width="404.3" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="distribution" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="237.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="COMPLICATED-SUBSYSTEM TEAM" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="471.0" y="170.0" width="217.6" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="where the code graph lives if it is large enough to need specialists" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="192.8" width="449.7" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="Chapter 9&#x27;s freshness problem is a real discipline, not a side" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="207.8" width="410.8" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="project" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="222.8" width="53.5" height="17.2" as="geometry"/></mxCell><mxCell id="c23" value="X-as-a-Service silently requires the bounded-topology commitment — without it the mode degrades to collaboration, and the platform team becomes a" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="276.5" width="975.1" height="17.5" as="geometry"/></mxCell><mxCell id="c24" value="queue." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="292.5" width="48.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 16.3" id="figure-16-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="287" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="205.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="WHY AN ADVISORY SENSOR ADDS WORK AND A BLOCKING ONE REMOVES IT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="385.6" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="ADVISORY SENSOR" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="the bot comments on the PR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="agent produces diff" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="bot reviews, leaves 6 comments" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="HUMAN reads the diff ▓▓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="HUMAN triages 6 bot comments ▓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="review time: UNCHANGED or WORSE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="BLOCKING SENSOR" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="it refuses the edit" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="agent produces diff" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="sensor: NO → agent retries" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="sensor: OK → applied" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="HUMAN reads the diff ▓▓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="(this class of defect cannot be present)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="267.8" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="review time: REDUCED — but only if the human is willing NOT to look" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="443.2" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="Review by exception saves time only if the reviewer can skip reading. That requires blocking, and evidence." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="14.8" y="216.0" width="870.4" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 16.4" id="figure-16-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="284" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=12;fillColor=#0F766E;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="250.0" y="30.0" width="20.0" height="22.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=12;fillColor=#0F766E;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="250.0" y="80.0" width="15.0" height="22.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=12;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="1"><mxGeometry x="250.0" y="114.0" width="498.0" height="22.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="250.0" y="164.0" width="150.0" height="22.0" as="geometry"/></mxCell><mxCell id="c5" value="COST PER ACCEPTED CHANGE — THE INPUT YOU METER IS NOT THE INPUT THAT IS SCARCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="483.0" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="tokens" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="187.5" y="33.8" width="50.5" height="18.2" as="geometry"/></mxCell><mxCell id="c7" value="metered" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="280.0" y="33.5" width="62.2" height="18.5" as="geometry"/></mxCell><mxCell id="c8" value="budgeted, reviewed monthly, on a tools line" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="-31.9" y="51.5" width="269.9" height="16.5" as="geometry"/></mxCell><mxCell id="c9" value="compute" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="180.5" y="83.8" width="57.5" height="18.2" as="geometry"/></mxCell><mxCell id="c10" value="metered" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="275.0" y="83.5" width="62.2" height="18.5" as="geometry"/></mxCell><mxCell id="c11" value="HUMAN REVIEW MINUTES" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="78.7" y="117.8" width="159.3" height="18.2" as="geometry"/></mxCell><mxCell id="c12" value="NOT metered" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="758.0" y="117.5" width="93.2" height="18.5" as="geometry"/></mxCell><mxCell id="c13" value="invisible inside salary · no budget line · nobody reports it" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="-135.4" y="135.5" width="373.4" height="16.5" as="geometry"/></mxCell><mxCell id="c14" value="rework (probability × cost)" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="38.9" y="167.8" width="199.1" height="18.2" as="geometry"/></mxCell><mxCell id="c15" value="partly visible" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="410.0" y="167.5" width="116.5" height="18.5" as="geometry"/></mxCell><mxCell id="c16" value="Ch 14&#x27;s rework rate — rarely costed" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="16.9" y="185.5" width="221.1" height="16.5" as="geometry"/></mxCell><mxCell id="c17" value="Token frugality is optimising the abundant input. Any token spend that reliably removes review minutes pays for itself." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="216.5" width="801.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 16.5" id="figure-16-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="218" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="442.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="458.0" y="30.0" width="442.0" height="110.0" as="geometry"/></mxCell><mxCell id="c3" value="SAMPLING AUDIT: 200 CHANGES, 5% SAMPLED, 2% TRUE ESCAPE RATE → 0.2 EXPECTED FINDINGS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="519.6" height="16.5" as="geometry"/></mxCell><mxCell id="c4" value="✓ WHAT IT CAN DO" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="137.0" height="19.0" as="geometry"/></mxCell><mxCell id="c5" value="tell you, over a YEAR and across TEAMS, whether the escape rate is" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="436.7" height="17.2" as="geometry"/></mxCell><mxCell id="c6" value="rising" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="47.0" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="compare two review regimes at organisational scale" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="332.8" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="make trusting a blocking sensor RATIONAL rather than a leap of faith" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="449.7" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="✗ WHAT IT CANNOT DO" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="471.0" y="44.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="give a team a usable quarterly number" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="66.8" width="248.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="identify WHICH change leaked" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="81.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="be scaled up — the audit consumes the very capacity it is measuring" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="471.0" y="96.8" width="443.2" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="The instrument is real and its resolution is coarse. Claiming more would be the error this book was written to correct." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="150.5" width="801.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 17.1" id="figure-17-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="357" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="110.0" y="8.0" width="680.0" height="43.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="110.0" y="79.0" width="680.0" height="79.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="110.0" y="186.0" width="680.0" height="95.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="54.0" as="sourcePoint"/><mxPoint x="450.0" y="76.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="161.0" as="sourcePoint"/><mxPoint x="450.0" y="183.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="THE PRICE OF PRODUCING CODE FELL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="123.0" y="22.0" width="265.9" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="four goods withdrawn" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="123.0" y="93.0" width="169.2" height="19.0" as="geometry"/></mxCell><mxCell id="c8" value="production was the expensive step · the author had interrogable intent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="123.0" y="115.8" width="462.7" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="feedback outran change · reading was never dangerous" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="123.0" y="130.8" width="345.8" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="ten habits stopped paying" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="123.0" y="200.0" width="209.5" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="1 author→director · 2 code→intent · 3 speed sense→measurement · 4 fix output→fix control" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="123.0" y="222.8" width="579.6" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="5 individual→system · 6 trust as trait→estimate · 8 tacit→externalised" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="123.0" y="238.8" width="462.7" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="9 adopt tool→redesign work · 10 data→instruction" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="123.0" y="253.8" width="319.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="Nobody changed ten things about engineering. One thing changed, and ten habits stopped paying." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="124.3" y="289.2" width="651.3" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 17.2" id="figure-17-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="321" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="171.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="171.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="221.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="THE SHIFTS ARE NOT THE SAME KIND OF THING" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="257.7" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="INFORMATIONAL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="you learn a fact and act" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="10 · input is instruction" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="2 · specifying intent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="9 · redesign the work" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="1 · author → director" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="resistance: LOW" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="157.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="fixed by: writing it down" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="172.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="BEHAVIOURAL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="you know the fact and still don&#x27;t" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="3 · trusting your speed sense" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="4 · fix the control, not the output" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="5 · individual velocity" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="6 · trust as estimate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="8 · externalise the tacit" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="resistance: HIGH" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="111.9" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="fixed by: NOT information" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="172.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="Each behavioural shift requires overriding a signal your nervous system is still producing. METR&#x27;s cohort knew the" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-13.4" y="232.0" width="926.8" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="result and still felt fast." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="337.2" y="250.0" width="225.6" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 17.3" id="figure-17-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="257" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="WHY THE BEHAVIOURAL SHIFTS DO NOT HAPPEN BY PERSUASION" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="336.9" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="COST" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="40.2" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="borne by the individual, this sprint, visibly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="300.3" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="▓▓▓▓▓▓▓▓▓ build the control" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="▓▓▓▓▓▓ write the spec" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="▓▓▓▓ report honestly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="▓▓▓ lose craft satisfaction" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="BENEFIT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="accrues to the system, later, diffusely" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="261.3" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="░░ own team, eventually" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="░░ every future task" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="░░ every future decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="░░ people who have not joined yet" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="This is Chapter 16&#x27;s Figure 16.1, one level down. A compensation and recognition problem, not a training problem." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-9.4" y="186.0" width="918.8" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 18.1" id="figure-18-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="290" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="190.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="TWO ROBUST FINDINGS THAT APPEAR TO CONTRADICT EACH OTHER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="349.0" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="TRUST IN OUTPUT ACCURACY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="Stack Overflow 2025" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="highly trust ▏ 3%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="trust ████ 33%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="distrust ███████ 46%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="trend: ▼ falling, 31% → 46%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="tight feedback loop → WELL CALIBRATED" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="248.4" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="BELIEF ABOUT OWN THROUGHPUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="225.6" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="METR 2025–26" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="forecast +24%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="retrospective +20%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="MEASURED −19%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="gap: ~40 points" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="no feedback loop at all → SYSTEMATICALLY WRONG" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="306.8" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="&quot;Our engineers are appropriately sceptical&quot; is not protection. Scepticism about accuracy is orthogonal to" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="22.9" y="201.0" width="854.3" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="calibration about speed." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="349.3" y="219.0" width="201.4" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 18.2" id="figure-18-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="260" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="160.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="THE INSTRUMENT IS NOT BIASED — IT IS DISCONNECTED" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="306.4" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="WITHOUT AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="88.6" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="electrodermal activity → correlates → PERFORMANCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="326.3" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="NASA-TLX physical demand → correlates → PERFORMANCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="the internal signals carry information about how well the work is" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="430.2" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="going" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="40.5" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="WITH AI" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="electrodermal activity → ✗ no correlation → PERFORMANCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="365.3" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="and none of the other five workload dimensions either" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="352.3" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="the signals have DECOUPLED from the outcome" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="287.3" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="A biased instrument can be corrected. A decoupled one cannot — so calibration must come from outside, or not at" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-1.3" y="171.0" width="902.7" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="all." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="429.9" y="189.0" width="40.2" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 18.3" id="figure-18-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="262" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="TRUST IS AN ALLOCATION FUNCTION OVER THE CONSTRAINT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="318.6" height="16.5" as="geometry"/></mxCell><mxCell id="c4" value="WELL ALLOCATED" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c5" value="high blast radius ▓▓▓▓▓▓▓▓▓▓▓▓▓▓ · moderate ▓▓▓▓▓ · trivial ▓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="404.3" height="17.2" as="geometry"/></mxCell><mxCell id="c6" value="MISCALIBRATED — same total, wrong distribution" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="378.8" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="high blast radius ▓▓▓▓ ← escapes · moderate ▓▓▓▓▓ · trivial ▓▓▓▓▓▓▓▓▓▓▓ ← waste" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="521.2" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="Miscalibrated trust is misallocated verification capacity — which is why it is measurable through behaviour even though it is not accessible" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="178.5" width="941.8" height="17.5" as="geometry"/></mxCell><mxCell id="c9" value="through introspection." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="194.5" width="154.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 18.4" id="figure-18-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="344" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="156.0" width="900.0" height="95.0" as="geometry"/></mxCell><mxCell id="c3" value="THE PREDICTION LOG — THE CHEAPEST INSTRUMENT IN PART IV, ~5 SECONDS PER REVIEW" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="483.0" height="16.5" as="geometry"/></mxCell><mxCell id="c4" value="before opening an agent-produced change, record one bit: will this need changes?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="652.8" height="19.0" as="geometry"/></mxCell><mxCell id="c5" value="03/04 auth-refactor predicted: clean actual: 3 edits ✗" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="358.8" height="17.2" as="geometry"/></mxCell><mxCell id="c6" value="03/04 dep-bump predicted: clean actual: clean ✓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="313.3" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="03/05 rate-limit predicted: needs work actual: 2 edits ✓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="371.8" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="03/05 api-schema predicted: clean actual: 7 edits ✗" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="after ~40 reviews you have something nobody currently has: your own hit rate, by task class" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="170.0" width="741.5" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="over-trusting? predicted clean, wasn&#x27;t, repeatedly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.8" width="332.8" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="under-trusting? predicted problems that never materialised" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="207.8" width="384.8" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="and the feedback arrives in MINUTES — which is what calibration requires" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="222.8" width="475.7" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="It works exactly where throughput estimation fails: an observable event rather than a counterfactual, and an external record rather than" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="260.5" width="915.1" height="17.5" as="geometry"/></mxCell><mxCell id="c14" value="introspection." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="276.5" width="101.4" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 19.1" id="figure-19-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="357" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="292.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="3