;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="107.3" y="117.8" width="170.7" height="18.2" as="geometry"/></mxCell><mxCell id="c13" value="11.00%" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="597.0" y="117.5" width="54.5" height="18.5" as="geometry"/></mxCell><mxCell id="c14" value="bare shell + demonstration" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="111.7" y="135.5" width="166.3" height="16.5" as="geometry"/></mxCell><mxCell id="c15" value="SWE-agent · GPT-4 Turbo" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="96.0" y="167.8" width="182.0" height="18.2" as="geometry"/></mxCell><mxCell id="c16" value="12.47%" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="637.0" y="167.5" width="54.5" height="18.5" as="geometry"/></mxCell><mxCell id="c17" value="purpose-built interface" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="129.9" y="185.5" width="148.1" height="16.5" as="geometry"/></mxCell><mxCell id="c18" value="SWE-agent · Lite split" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="103.6" y="217.8" width="174.4" height="18.2" as="geometry"/></mxCell><mxCell id="c19" value="18.00%" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="787.0" y="217.5" width="54.5" height="18.5" as="geometry"/></mxCell><mxCell id=