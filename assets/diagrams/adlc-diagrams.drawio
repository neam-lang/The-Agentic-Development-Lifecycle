try"><mxPoint x="746.0" y="108.0" as="sourcePoint"/><mxPoint x="831.0" y="48.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="high" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.8;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="52.9" y="47.2" width="33.1" height="16.8" as="geometry"/></mxCell><mxCell id="c17" value="low" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.8;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="59.2" y="227.2" width="26.8" height="16.8" as="geometry"/></mxCell><mxCell id="c18" value="elasticity &lt; 1 — slack" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="96.3" y="238.6" width="153.5" height="17.4" as="geometry"/></mxCell><mxCell id="c19" value="elasticity 1–2 — loading up" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="497.7" y="174.6" width="186.5" height="17.4" as="geometry"/></mxCell><mxCell id="c20" value="&gt; 3" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="814.0" y="16.0" width="34.0" height="20.0" as="geometry"/></mxCell><mxCell id="c21" value="on the cliff" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="787.3" y="54.6" width="87.3" height="17.4" as="geometry"/></mxCell><mxCell id="c22" value="low arrivals" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="96.0" y="262.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c23" value="ARRIVAL RATE λ ──────►" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="408.8" y="263.0" width="148.4" height="17.0" as="geometry"/></mxCell><mxCell id="c24" value="ρ → 1" style="text;html=1;align=right;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="829.5" y="262.8" width="40.5" height="17.2" as="geometry"/></mxCell><mxCell id="c25" value="SATURATION ELASTICITY = %Δ W / %Δ λ, quarter on quarter. You never need to estimate μ." style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="112.0" y="299.5" width="674.5" height="18.5" as="geometry"/></mxCell><mxCell id="c26" value="W must be WAIT — open to first HUMAN review — not duration. That definitional choice decides everything." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="112.0" y="317.5" width="701.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 14.2" id="figure-14-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="321" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="171.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="171.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="221.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="BATCHING IS A FALSE RELIEF VALVE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="202.9" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="BEFORE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="56.4" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="λ = 100 PRs / week" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="μ = 125 PRs / week" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="ρ = 0.80" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="60.0" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="AFTER BATCHING" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="halve the count, double the size" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="λ = 50 PRs / week ▼ halved" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="μ = 62.5 PRs / week ▼ halved" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="ρ = 0.80 ═ UNCHANGED" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="✗ reviewability per item" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="✗ blast radius per item" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="✗ revert granularity" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="✗ small batches — moving the wrong way" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="172.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="Enlarging batches relieves the item count and not the load. Utilisation is invariant; every other property" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="18.8" y="232.0" width="862.4" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="degrades." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="409.7" y="250.0" width="80.5" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 14.3" id="figure-14-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="290" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="190.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="A DASHBOARD WITH MIXED HORIZONS LIES BY JUXTAPOSITION" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="330.8" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="✗ ONE BOARD" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="first-pass acceptance ▲ 12% ← moves weekly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="review load ▼ 8% ← moves weekly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="cost per change ▼ 4% ← moves monthly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="complexity trend ── 0% ← moves QUARTERLY" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="267.8" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="duplication trend ── 0% ← moves QUARTERLY" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="conclusion drawn within a month: the bottom two do not matter" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="404.3" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="✓ SEGREGATED BY HORIZON" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="193.4" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="OPERATIONAL — weekly, owned by the team" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="261.3" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="acceptance · rework · review load · W and λ · batch size" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="371.8" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="STRUCTURAL — quarterly, named owner, standing agenda slot" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="complexity · duplication · harness coverage · autonomy mix · time-" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="436.7" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="to-control" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="73.0" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="The slow metrics are not flat because they are unimportant. They are flat because they are slow — and proximity" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-1.3" y="201.0" width="902.7" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="teaches otherwise." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="373.5" y="219.0" width="153.1" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 14.4" id="figure-14-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="469" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="178.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="253.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="327.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c6" value="START HERE — FIVE METRICS, ROUGHLY ONE WEEK OF INSTRUMENTATION" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="385.6" height="16.5" as="geometry"/></mxCell><mxCell id="c7" value="1 · AUTONOMY MIX — distribution of merged work across A0–A4" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="483.5" height="19.0" as="geometry"/></mxCell><mxCell id="c8" value="reveals whether delegation is real or theatre · needs a level label on each merged change" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="586.1" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="2 · REWORK RATE — % of merged agent code changed within 14 days" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="515.8" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="the honesty guard on every throughput claim · needs authorship attribution + churn analysis" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="599.1" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="3 · BATCH SIZE — median lines per merged change" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.0" width="386.8" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="the unit-stability guard for every count above · needs nothing you do not already have" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.8" width="566.7" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="4 · W and λ → ELASTICITY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="267.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="the constraint itself · needs exclusion of automated review events" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="289.8" width="436.7" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="5 · TIME-TO-CONTROL — 2nd occurrence → control installed" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="341.0" width="459.4" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="whether the steering loop is a regulator or a historian · needs failure-mode labels, which is the hard part" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="363.8" width="703.1" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="1 and 2 tell you whether anything changed · 3 keeps them honest · 4 whether more will help · 5 whether you are learning." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="401.5" width="808.4" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 15.1" id="figure-15-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="300" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=12;fillColor=#7C3AED;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="1"><mxGeometry x="250.0" y="30.0" width="513.0" height="22.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=12;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="1"><mxGeometry x="250.0" y="80.0" width="18.0" height="22.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=12;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="250.0" y="130.0" width="5.0" height="22.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;fillColor=#64748B;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxG