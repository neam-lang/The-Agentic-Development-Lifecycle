parent="1"><mxGeometry x="589.2" y="282.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c36" value="Both failure modes present identically — confidently wrong output — and the remedies are opposite." style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="112.0" y="319.5" width="767.5" height="18.5" as="geometry"/></mxCell><mxCell id="c37" value="Starvation: RETRIEVE MORE. Dilution: SELECT HARDER. The default response to both is to add." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="112.0" y="337.5" width="615.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 6.2" id="figure-6-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="286" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=12;fillColor=#64748B;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="210.0" y="30.0" width="4.0" height="22.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=12;fillColor=#64748B;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="210.0" y="64.0" width="17.0" height="22.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=12;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="210.0" y="98.0" width="69.0" height="22.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="1"><mxGeometry x="210.0" y="132.0" width="540.0" height="22.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=12;fillColor=#7C3AED;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="1"><mxGeometry x="210.0" y="166.0" width="32.0" height="22.0" as="geometry"/></mxCell><mxCell id="c6" value="CAPACITY GREW BY ORDERS OF MAGNITUDE. THE OPTIMUM DID NOT." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="361.2" height="16.5" as="geometry"/></mxCell><mxCell id="c7" value="context window, 2022" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="48.5" y="33.8" width="149.5" height="18.2" as="geometry"/></mxCell><mxCell id="c8" value="8K" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#64748B;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="224.0" y="33.5" width="23.5" height="18.5" as="geometry"/></mxCell><mxCell id="c9" value="context window, 2023" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="48.5" y="67.8" width="149.5" height="18.2" as="geometry"/></mxCell><mxCell id="c10" value="32K" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#64748B;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="237.0" y="67.5" width="31.2" height="18.5" as="geometry"/></mxCell><mxCell id="c11" value="context window, 2024" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="48.5" y="101.8" width="149.5" height="18.2" as="geometry"/></mxCell><mxCell id="c12" value="128K" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="289.0" y="101.5" width="39.0" height="18.5" as="geometry"/></mxCell><mxCell id="c13" value="context window, 2026" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="38.7" y="135.8" width="159.3" height="18.2" as="geometry"/></mxCell><mxCell id="c14" value="1M+" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="760.0" y="135.5" width="31.2" height="18.5" as="geometry"/></mxCell><mxCell id="c15" value="USEFUL PAYLOAD OPTIMUM" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="23.6" y="169.8" width="174.4" height="18.2" as="geometry"/></mxCell><mxCell id="c16" value="~ flat" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#7C3AED;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="252.0" y="169.5" width="54.5" height="18.5" as="geometry"/></mxCell><mxCell id="c17" value="the gap is the room you now have to harm yourself" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="-108.4" y="187.5" width="306.4" height="16.5" as="geometry"/></mxCell><mxCell id="c18" value="Absence of a limit is not absence of a cost. A million-token window means nothing will stop you." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="218.5" width="648.3" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 6.3" id="figure-6-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="410" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="119.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="194.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="268.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="THE PROBLEM: THE AGENT MUST ACT ON A REPOSITORY IT CANNOT HOLD" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="385.6" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="1 · CONTEXT — design what it sees" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="saturates. The whole file scored 12.7% against 18.0% for a window of it." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="475.7" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="← this chapter" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="2 · GRAPH — let it FIND instead of being shown" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="133.0" width="378.8" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="progressive disclosure with a typed index · Ch 9" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="155.8" width="319.8" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="3 · STRUCTURE — reduce what must be KNOWN to change any one thing" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="208.0" width="531.9" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="bounded context regardless of repository size · Ch 10" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="230.8" width="352.3" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="4 · HARNESS — steer before, CHECK after, so being wrong is survivable" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="282.0" width="564.1" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="guides and sensors · Ch 7–8" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="304.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="Only the first is &quot;show it more&quot;, and the first has a ceiling. That ceiling is why the other three are not optional." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="342.5" width="781.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 7.1" id="figure-7-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="291" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=36;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="8.0" width="900.0" height="197.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=36;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="34.0" y="42.0" width="832.0" height="129.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=30;fillColor=#0F172A;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=94" vertex="1" parent="1"><mxGeometry x="170.0" y="94.0" width="560.0" height="65.0" as="geometry"/></mxCell><mxCell id="c4" value="USER HARNESS — yours" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="16.0" y="18.5" width="163.0" height="18.5" as="geometry"/></mxCell><mxCell id="c5" value="context files · skills · hooks · linters · tests · fitness functions · review agents · MCP" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="174.0" y="19.5" width="608.3" height="17.5" as="geometry"/></mxCell><mxCell id="c6" value="BUILDER HARNESS — the vendor&#x27;s" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50.0" y="52.5" width="240.5" height="18.5" as="geometry"/></mxCell><mxCell id="c7" value="system prompt · retrieval · orchestration · tool definitions" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="280.0" y="53.5" width="408.2" height="17.5" as="geometry"/></mxCell><mxCell id="c8" value="MODEL" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#FFFFFF;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="422.8" y="106.0" width="54.5" height="21.0" as="geometry"/></mxCell><mxCell id="c9" value="not yours · not stable · changes without notice" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.6;fontColor=#FFFFFF;resizable=1" vertex="1" parent="1"><mxGeometry x="287.9" y="130.4" width="324.2" height="17.6" as="geometry"/></mxCell><mxCell id="c10" value="Agent = Model + Harness. Harness engineering is the deliberate design of the OUTER ring." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.4;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="214.6" width="589.9" height="17.4" as="geometry"/></mxCell><mxCell id="c11" value="The inner two change under you without notice — so anything that must be stable belongs in the ring you control." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.4;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="231.6" width="748.5" height="17.4" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 7.2" id="figure-7-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="341" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="150.0" y="56.0" width="369.0" height="95.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="531.0" y="56.0" width="369.0" height="95.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="150.0" y="163.0" width="369.0" height="95.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="531.0" y="163.0" width="369.0" height="95.0" as="geometry"/></mxCell><mxCell id="c5" value="EVERY CONTROL YOU CAN BUILD SITS IN ONE OF THESE FOUR CELLS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="367.3" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="GUIDES — feedforward · prevent" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="213.8" y="31.5" width="240.5" height="18.5" as="geometry"/></mxCell><mxCell id="c7" value="SENSORS — feedback · detect &amp; self-correct" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="549.2" y="31.5" width="333.5" height="18.5" as="geometry"/></mxCell><mxCell id="c8" value="language servers · CLIs · scripts" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="163.0" y="70.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCel