e=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="27.5" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="monthly retrospective, quarterly platform work" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="306.8" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="human-paced" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="≈ 1000 : 1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="73.0" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="A regulator sampling a thousand times slower than its plant is not a regulator. It is a historian." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="51.1" y="171.0" width="797.9" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 12.4" id="figure-12-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="454" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="56.0" width="444.0" height="43.0" as="geometry"/></mxCell><m