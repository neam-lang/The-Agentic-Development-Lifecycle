mxCell id="c34" value="the monotone loop" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="286.0" width="145.0" height="19.0" as="geometry"/></mxCell><mxCell id="c35" value="Each substitute produces an artefact and no change. Each is one of Chapter 21&#x27;s anti-patterns, arriving on schedule." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="348.5" width="781.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 26.2" id="figure-26-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="469" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="178.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="253.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="327.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c6" value="STILL MISSING AT DAY 91" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="148.1" height="16.5" as="geometry"/></mxCell><mxCell id="c7" value="a graph" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c8" value="Ch 9 — needed before structural work in legacy (Ch 24 §24.5)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="397.8" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="harness templates" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="145.0" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="Ch 8 — needs a topology commitment, an executive decision" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="an enabling capability" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="Ch 16 — how other teams make the same move" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="structural improvement" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="267.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="Ch 10 — the expensive half of harnessability" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="289.8" width="293.8" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="a behaviour harness" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="341.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="Ch 8 — unsolved, everywhere, for everyone" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="363.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="Ninety days moves one team from L1 to a demonstrated L3 traversal. The last item is beyond anyone." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="401.5" width="661.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 27.1" id="figure-27-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="411" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="178.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="253.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="&quot;OPEN PROBLEM&quot; COVERS FOUR SITUATIONS THAT DIFFER IN THE ONLY WAY THAT MATTERS: WHO CAN ADDRESS THEM" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="617.0" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="UNSOLVED — nobody knows how; needs a genuine advance" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="427.1" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="owner: research · timeline: unknown" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="COUNT: 1" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="811.5" y="43.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="MISSING INSTRUMENT — we know what to measure and cannot yet measure it" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="572.2" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="owner: tool builders · timeline: quarters" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="4" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="867.9" y="117.0" width="16.1" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="MISSING EXPERIMENT — the study is designable and unrun" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.0" width="443.2" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="owner: researchers, or any team willing to A/B itself · timeline: weeks to a year" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.8" width="534.2" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="4" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="867.9" y="191.0" width="16.1" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="MISSING MEASUREMENT — the data exists inside organisations and is not collected" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="267.0" width="644.7" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="owner: anyone with the telemetry · timeline: a quarter" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="289.8" width="358.8" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="3" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="867.9" y="266.0" width="16.1" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="The field talks as though everything is in the top box. Almost nothing is — which is more optimistic than the tone suggests, and more" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="327.5" width="895.1" height="17.5" as="geometry"/></mxCell><mxCell id="c19" value="embarrassing." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="343.5" width="94.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 27.2" id="figure-27-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="517" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="8.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="100.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="192.0" width="620.0" h