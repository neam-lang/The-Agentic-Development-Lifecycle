►" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="386.5" y="263.0" width="193.0" height="17.0" as="geometry"/></mxCell><mxCell id="c23" value="ρ → 1.0" style="text;html=1;align=right;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="816.5" y="262.8" width="53.5" height="17.2" as="geometry"/></mxCell><mxCell id="c24" value="A team at ρ = 0.6 that doubles λ lands at ρ = 1.2. There is no ρ = 1.2 — something must give." style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="112.0" y="299.5" width="728.8" height="18.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 3.4" id="figure-3-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="456" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="119.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="209.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="298.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c5" value="Ρ → 1. SOMETHING MUST GIVE. CHOOSE:" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="221.1" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="1 · LET THE QUEUE GROW" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="λ unchanged, W rises → lead time up, work-in-progress up, delivery flat" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="469.2" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="the honest failure: visible, measurable, and blamed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="2 · REVIEW FASTER" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="133.0" width="145.0" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="μ raised by cutting service time → scrutiny per change falls, defects escape" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="155.8" width="501.7" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="Ch 21: REVIEW COLLAPSE. Invisible by construction" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="171.8" width="326.3" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="3 · ENLARGE THE BATCH" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="223.0" width="177.3" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="fewer, bigger items → λ falls but reviewability falls faster" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="245.8" width="397.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="moves away from DORA&#x27;s most protective practice — and Ch 14 shows ρ is unchanged" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="260.8" width="527.7" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="4 · CHANGE THE SERVER" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="312.0" width="177.3" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="μ raised by mechanising verification → automated review takes the load" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="334.8" width="462.7" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="the ONLY valve that adds capacity — and the only one that is an engineering discipline" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="349.8" width="566.7" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="Valves 1–3 pay for throughput with lead time, quality, or reviewability. Part II is about valve 4." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="388.5" width="661.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 3.5" id="figure-3-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="290" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="190.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="THE SAME EVIDENCE, TWO MEASUREMENT WINDOWS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="263.8" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="ACUTE proxies" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="hours → days" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="did it merge?" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="did it revert?" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="ANSWER: flat" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="window of the enterprise study: 12 months" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="CHRONIC proxies" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="months → years" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="complexity trend" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="111.9" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="warning density" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="duplication" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="ANSWER: persistent increase" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="window of the debt studies: 2–4 years" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="248.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="Not rival findings. Answers to different questions asked over different intervals — and the gap between them is" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-1.3" y="201.0" width="902.7" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="where the disagreement lives." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="329.1" y="219.0" width="241.7" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 4.1" id="figure-4-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="260" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="160.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="THE LEDGER IS ASYMMETRIC IN MEASURABILITY BEFORE IT IS ASYMMETRIC IN OUTCOME" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="470.8" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="BENEFITS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="prompt — days" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="countable — PRs, tasks, lines" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="attributable — to a person, a tool, a quarter" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="300.3" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="defended by whoever bought the tool" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="COSTS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="48.3" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="deferred — months to years" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="contestable — proxies, all arguable" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="ownerless — no one team&#x27;s metric" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="defended by nobody in particular" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="Where one side of a ledger is cheap to measure and the other is expensive, the cheap side wins — regardless of" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2.7" y="171.0" width="894.6" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="which is larger." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="381.5" y="189.0" width="137.0" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 4.2" id="figure-4-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="220" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="8.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="8.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="138.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="what a REVERT measures" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="22.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c5" value="hours → days" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c6" value="&quot;did this change break something we noticed?&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="59.8" width="300.3" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="acute failure" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="74.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="someone noticed within days" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="90.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="what COMPLEXITY measures" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="22.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="months → years" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="&quot;is the next change going to cost more than it should?&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="59.8" width="365.3" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="chronic accretion" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="74.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="by the time it shows, no individual change is blameable" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="90.8" width="365.3" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="Nobody has measured both, on the same codebase, over a window long enough to settle it." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="95.4" y="149.0" width="709.2" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 4.3" id="figure-4-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="293" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="143.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="143.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="193.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="BOTH OPTIONS ARE CORRECT — BUT THEY ARE NOT EQUALLY CHEAP" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="355.1" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="DUPLICATE and modify" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="169.2" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="copy the logic, adjust it, use it locally" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="touches one file" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="111.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="breaks nothing" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="HUMAN: cheap, but feels bad" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="AGENT: cheap, feels nothing" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="cheap for both" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="146.0" width="129.5" height="20.0" as="geometry"/></mxCell><mxCell id="c12" value="EXTRACT and reuse" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="145.0" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="pull out a shared abstraction, adapt both call sites" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="345.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="requires knowing EVERY call site" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="a repository-wide question answered from partial observation" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="397.8" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="HUMAN: costly, but satisfying" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="AGENT: costly, and nothing opposes the alternative" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="332.8" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="costly — much more so for an agent" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4338CA;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="146.0" width="303.1" height="20.0" as="geometry"/></mxCell><mxCell id="c19" value="The agent faces a steeper gradient toward duplication — and no counter-force. Aesthetic disgust does not survive" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-5.4" y="204.0" width="910.7" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="delegation." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="401.7" y="222.0" width="96.7" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 4.4" id="figure-4-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="287" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="205.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="DELEGATION DID NOT ADD A DEBT-PRODUCING MECHANISM. IT REMOVED A DEBT-REMOVING ONE." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="507.4" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="THE CLASSICAL LOOP" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="153.1" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="implicit, unmeasured, load-bearing" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="additive change → complexity ▲" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="→ maintainer discomfort" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="→ &quot;this is unpleasant&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="→ refactoring" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="→ complexity ▼" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="a negative feedback loop nobody designed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="157.8" width="267.8" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="THE DELEGATED LOOP" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="153.1" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="the homeostat is gone" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="additive change → complexity ▲" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="(much faster now)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="→ ░░ nothing ░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="→ no refactoring pressure" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="result: monotone growth, no upper bound" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="261.3" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="and the input rate has multiplied" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="So the remedy is an installed sensor with a standing mandate — not a better instruction." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="91.4" y="216.0" width="717.3" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 4.5" id="figure-4-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="377" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=24;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="96.0" y="282.0" width="774.0" height="51.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="ellipse;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="150.5" y="113.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="320.5" y="83.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="490.5" y="73.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="661.5" y="149.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="800.5" y="213.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=1.4" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.0" y="34.0" as="sourcePoint"/><mxPoint x="96.0" y="234.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=1.4" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.0" y="234.0" as="sourcePoint"/><mxPoint x="870.0" y="234.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="" style="endArrow=none;html=1;strokeColor=#F1F5F9;strokeWidth=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.0" y="67.0" as="sourcePoint"/><mxPoint x="870.0" y="67.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="" style="endArrow=none;html=1;strokeColor=#F1F5F9;strokeWidth=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.0" y="201.0" as="sourcePoint"/><mxPoint x="870.0" y="201.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="endArrow=none;html=1;strokeColor=#0F172A;strokeWidth=1.6;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.0" y="134.0" as="sourcePoint"/><mxPoint x="870.0" y="134.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="" style="endArrow=none;html=1;strokeColor=#BE123C;strokeWidth=2.6;opacity=30" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="158.0" y="121.0" as="sourcePoint"/><mxPoint x="328.0" y="91.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=none;html=1;strokeColor=#BE123C;strokeWidth=2.6;opacity=30" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="328.0" y="91.0" as="sourcePoint"/><mxPoint x="498.0" y="81.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=none;html=1;strokeColor=#BE123C;strokeWidth=2.6;opacity=30" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="498.0" y="81.0" as="sourcePoint"/><mxPoint x="669.0" y="157.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=none;html=1;strokeColor=#BE123C;strokeWidth=2.6;opacity=30" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="669.0" y="157.0" as="sourcePoint"/><mxPoint x="808.0" y="221.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="gain" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.8;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="52.9" y="60.2" width="33.1" height="16.8" as="geometry"/></mxCell><mxCell id="c17" value="loss" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.8;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="52.9" y="194.2" width="33.1" height="16.8" as="geometry"/></mxCell><mxCell id="c18" value="0" style="text;html=1;align=right;verticalAlign=middle;fontSize=11.5;fontColor=#0F172A;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="70.9" y="126.5" width="15.1" height="17.5" as="geometry"/></mxCell><mxCell id="c19" value="+26%" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="306.6" y="59.0" width="42.7" height="20.0" as="geometry"/></mxCell><mxCell id="c20" value="bounded upside" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="277.7" y="97.6" width="100.6" height="17.4" as="geometry"/></mxCell><mxCell id="c21" value="Amdahl caps it" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="447.7" y="87.6" width="100.6" height="17.4" as="geometry"/></mxCell><mxCell id="c22" value="the tail" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="769.3" y="233.0" width="77.4" height="20.0" as="geometry"/></mxCell><mxCell id="c23" value="rewrite · abandoned migration" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="708.1" y="179.6" width="199.7" height="17.4" as="geometry"/></mxCell><mxCell id="c24" value="low" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="96.0" y="252.8" width="27.5" height="17.2" as="geometry"/></mxCell><mxCell id="c25" value="EXPOSURE TO AGENT OUTPUT ──────►" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="376.9" y="253.0" width="212.2" height="17.0" as="geometry"/></mxCell><mxCell id="c26" value="high" style="text;html=1;align=right;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="836.0" y="252.8" width="34.0" height="17.2" as="geometry"/></mxCell><mxCell id="c27" value="Bounded gains against an open-ended tail. Taleb calls this shape concave, or fragile." style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="112.0" y="289.5" width="666.8" height="18.5" as="geometry"/></mxCell><mxCell id="c28" value="A perfectly rational position to hold — provided you know you hold it, and are paid for it." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="112.0" y="307.5" width="615.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 5.2" id="figure-5-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="257" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="THE COLLAPSE OF THE EFFORT PROXY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="202.9" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="1975 – 2020" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="effort was a usable proxy" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="a change that existed had been reasoned about" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="300.3" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="hours of human cognition preceded the artefact" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="306.8" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="the artefact was EVIDENCE of the cognition" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="review could be cheap because authorship was expensive" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="358.8" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="NOW" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="32.2" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="the axis collapsed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="every change costs about the same: nothing" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="the proxy carries no information" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="care may be entirely present — you simply cannot read it off" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="397.8" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="the gate remains in the diagram; its content is zero" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="345.8" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="A pull request was never a checkpoint by design. It was a checkpoint by COST." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="135.7" y="186.0" width="628.6" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 5.3" id="figure-5-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="236" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="34.0" width="437.0" height="95.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="463.0" y="34.0" width="437.0" height="95.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="441.0" y="81.0" as="sourcePoint"/><mxPoint x="459.0" y="81.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="A REGULATOR SLOWER THAN ITS PLANT DOES NOT REGULATE IT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="336.9" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="PLANT — change" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="48.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="fast, elastic, cheap" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="70.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="machine-paced" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="85.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="►►►►►►►►►►►►" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="100.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="REGULATOR — review" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="476.0" y="48.0" width="153.1" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="slow, inelastic, human" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="476.0" y="70.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="►────►────►" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="476.0" y="85.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="Shift-left assumes the detector outruns the change." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="277.4" y="139.6" width="345.2" height="17.4" as="geometry"/></mxCell><mxCell id="c13" value="Once it does not, &quot;catch it early&quot; describes an intention rather than a mechanism." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.4;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="174.9" y="168.6" width="550.2" height="17.4" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 5.4" id="figure-5-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="560" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="292.0" height="60.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="304.0" y="56.0" width="292.0" height="60.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="608.0" y="56.0" width="292.0" height="60.0" as="geometry"/></mx