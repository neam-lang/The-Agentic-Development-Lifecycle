"><mxGeometry x="537.0" y="214.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c25" value="not &quot;review this PR&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="537.0" y="229.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c26" value="INFERENTIAL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="187.5" width="93.2" height="18.5" as="geometry"/></mxCell><mxCell id="c27" value="judgement" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="207.2" width="64.4" height="16.8" as="geometry"/></mxCell><mxCell id="c28" value="costly, fallible" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="222.2" width="108.2" height="16.8" as="geometry"/></mxCell><mxCell id="c29" value="Build in the order 3 → 1 → 2 → 7 → 8 → 6 → 9. Chapter 26 §26.2: the blocking check first, because it is the highest-authority control and the" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="273.5" width="948.5" height="17.5" as="geometry"/></mxCell><mxCell id="c30" value="cheapest to retrofit." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="289.5" width="148.1" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Unnumbered 3 — One Board" id="unnumbered-3-one-board"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="318" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="186.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="186.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="236.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="WHY THE METRICS SPLIT ACROSS TWO SURFACES" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="257.7" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="✗ ONE BOARD" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="everything on one surface, one cadence" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="acceptance ▁▃▅▇ ▲12%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="review load ▇▅▃▁ ▼8%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="cost/change ▃▄▃▂ ▼4%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="complexity ▄▄▄▄ ── 0%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="duplication ▄▄▄▄ ── 0%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="Three move. Two never do. Every viewer" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="172.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="concludes the bottom two do not matter." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="188.8" width="261.3" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="✓ TWO BOARDS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="each metric on the cadence it actually moves at" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="313.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="OPERATIONAL — weekly, the team" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="▸ acceptance · rework · review load" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="▸ W and λ · batch size" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="STRUCTURAL — quarterly, named owner," style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="standing agenda slot" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="▸ complexity · duplication · harness coverage" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="172.8" width="300.3" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="▸ autonomy mix · time-to-control" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="188.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c23" value="A metric that never moves on the cadence you display it at reads as noise — and gets treated as noise." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="34.9" y="247.0" width="830.1" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Unnumbered 4 — Gate, Day 30" id="unnumbered-4-gate-day-30"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="238" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="289.0" height="130.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="305.0" y="30.0" width="289.0" height="130.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="611.0" y="30.0" width="289.0" height="130.0" as="geometry"/></mxCell><mxCell id="c4" value="GATE, DAY 30 — ALL THREE ARE ARTEFACT TESTS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="269.9" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="Can you produce the four numbers?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="Not estimate. Produce." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="yes / no" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4338CA;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="85.0" width="77.4" height="20.0" as="geometry"/></mxCell><mxCell id="c8" value="Does the blocking check REFUSE a" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="318.0" y="44.0" width="265.9" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="bad edit?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="318.0" y="61.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="Demonstrated, not configured." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="318.0" y="83.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="Ch 13 §13.9: a control never" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="318.0" y="98.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="seen to fire is a belief." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="318.0" y="113.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="yes / no" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="318.0" y="133.0" width="77.4" height="20.0" as="geometry"/></mxCell><mxCell id="c14" value="Are traces queryable?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="624.0" y="44.0" width="177.3" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="Can you answer &quot;what happened" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="624.0" y="66.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="in that session?&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="624.0" y="81.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="yes / no" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="624.0" y="100.0" width="77.4" height="20.0" as="geometry"/></mxCell><mxCell id="c18" value="Nothing here required a budget, a mandate, or a meeting with anyone above the person doing it." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="170.5" width="635.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>