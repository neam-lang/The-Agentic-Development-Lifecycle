" value="delegate more ──── the loop closes" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="183.0" y="419.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="A vicious cycle. The parallel path — better harness → tool-confidence rises → less critical thinking — is not a cycle; it is the one-time" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="-22.8" y="456.2" width="945.6" height="17.8" as="geometry"/></mxCell><mxCell id="c21" value="price of the harness working." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="346.8" y="473.2" width="206.5" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 19.3" id="figure-19-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="399" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="8.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="100.0" width="620.0" height="43.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="171.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="263.0" width="620.0" height="43.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="75.0" as="sourcePoint"/><mxPoint x="450.0" y="97.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="146.0" as="sourcePoint"/><mxPoint x="450.0" y="168.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="238.0" as="sourcePoint"/><mxPoint x="450.0" y="260.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="THE WORK IS NOW: verification and integration" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="22.0" width="370.7" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="Lee et al." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="44.8" width="73.0" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="THE FACULTY REQUIRED: judgment about whether output is right" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="114.0" width="491.6" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="ITS FEEDBACK SIGNAL: ░░ decoupled from performance ░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="153.0" y="185.0" width="435.2" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="Burelli et al., Ch 18" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="207.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="THE PRACTICE THAT WOULD MAINTAIN IT: ░░ delegated ░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="153.0" y="277.0" width="427.1" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="You are asked to do more verification, using a faculty whose feedback signal has been disconnected, while the practice that would sharpen it" style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="-33.1" y="314.2" width="966.2" height="17.8" as="geometry"/></mxCell><mxCell id="c15" value="is the thing you handed over." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="346.8" y="331.2" width="206.5" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 19.4" id="figure-19-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="260" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="160.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="AN ORDERING EFFECT WITH A MEASURED BRAIN CORRELATE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="312.5" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="LLM → BRAIN" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="delegate first, engage after" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="shallow encoding" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="111.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="poor recall" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="&quot;not deeply internalised&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="BRAIN → LLM" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="attempt first, delegate after" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="higher recall" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="prefrontal + occipito-parietal activation preserved" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="comparable to search-engine users" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="Same task, same tool, same total effort, opposite cognitive outcome. Order is a free variable and almost nobody" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-1.3" y="171.0" width="902.7" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="sets it deliberately." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="361.4" y="189.0" width="177.3" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 20.1" id="figure-20-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="460" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="444.0" height="60.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="56.0" width="444.0" height="60.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="128.0" width="444.0" height="60.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="128.0" width="444.0" height="60.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="200.0" width="444.0" height="60.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="200.0" width="444.0" height="60.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="272.0" width="444.0" height="46.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="272.0" width="444.0" height="46.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="330.0" width="444.0" height="46.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="330.0" width="444.0" height="46.0" as="geometry"/></mxCell><mxCell id="c11" value="THE BOTTOM RUNGS WERE NOT A LADDER ANYONE BUILT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="294.2" height="16.5" as="geometry"/></mxCell><mxCell id="c12" value="THE TASK" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="187.0" y="31.5" width="70.0" height="18.5" as="geometry"/></mxCell><mxCell id="c13" value="WHAT IT TAUGHT — none of it the point" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="530.6" y="31.5" width="294.8" height="18.5" as="geometry"/></mxCell><mxCell id="c14" value="&quot;fix this small bug&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="70.0" width="169.2" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="where things are · how failure actually presents · that" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="70.0" width="451.3" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="the obvious cause is usually wrong" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="87.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="&quot;add a field here&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.0" width="153.1" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="what else touches this — blast radius, felt rather than" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="142.0" width="451.3" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="computed" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="159.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="&quot;write the missing test&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="what &quot;correct&quot; means for this code · which behaviours" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="214.0" width="435.2" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="are load-bearing" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="231.0" width="137.0" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="&quot;update this dependency&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="286.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="what breaks when something beneath you moves" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="286.0" width="362.6" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="&quot;follow the existing pattern&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="344.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c26" value="which conventions are deliberate and which are habit" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="344.0" width="427.1" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="The task was the deliverable. The learning was a by-product nobody was billed for — and the arbitrage that paid for it is gone." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="392.5" width="855.1" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 20.2" id="figure-20-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="411" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="644.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=18;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="644.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="644.0" y="118.2" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=18;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="644.0" y="118.2" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="178.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="636.0" y="192.4" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=18;fillColor=#64748B;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="636.0" y="192.4" width="42.0" height="12.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="253.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="659.0" y="266.6" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=18;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="659.0" y="266.6" width="51.0" height="12.0" as="geometry"/></mxCell><mxCell id="c13" value="THE BIFURCATION — TWO [A]-GRADE FINDINGS POINTING OPPOSITE WAYS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="391.7" height="16.5" as="geometry"/></mxCell><mxCell id="c14" value="JUNIOR — immediate gain" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="193.4" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="Cui et al.: less experienced developers had higher adoption AND greater gains" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="508.2" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="LARGEST" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="819.6" y="43.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="JUNIOR — developmental cost" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="225.6" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="less self-efficacy to protect · nothing yet consolidated · the offloading pattern does not attenuate" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="657.6" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="LARGEST" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="819.6" y="117.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="SENIOR — immediate gain" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.0" width="193.4" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="METR: negative on familiar code" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="smallest" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#64748B;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="811.5" y="191.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="SENIOR — developmental cost" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="267.0" width="225.6" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="competence already built · §19.6&#x27;s relocation to specification judgment is available" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="289.8" width="553.7" height="17.2" as="geometry"/></mxCell><mxCell id="c25" value="lower" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="835.7" y="266.0" width="48.3" height="19.0" as="geometry"/></mxCell><mxCell id="c26" value="Individually rational, maximally rewarded, and invisible to the person in it — because the signal is decoupled and the assessing faculty is the" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="327.5" width="961.8" height="17.5" as="geometry"/></mxCell><mxCell id="c27" value="one degrading." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="343.5" width="101.4" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 20.3" id="figure-20-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="488" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="90.0" y="56.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="501.0" y="56.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="90.0" y="128.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="501.0" y="128.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="90.0" y="200.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="501.0" y="200.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="90.0" y="272.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="501.0" y="272.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="90.0" y="344.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="501.0" y="344.0" width="399.0" height="60.0" as="geometry"/></mxCell><mxCell id="c11" value="THE SAME LADDER, READ DEVELOPMENTALLY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="233.3" height="16.5" as="geometry"/></mxCell><mxCell id="c12" value="AS GOVERNANCE (Ch 13)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="204.6" y="31.5" width="170.8" height="18.5" as="geometry"/></mxCell><mxCell id="c13" value="AS CURRICULUM (this chapter)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="587.5" y="31.5" width="225.0" height="18.5" as="geometry"/></mxCell><mxCell id="c14" value="human authors — sensitive/regulated work" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="103.0" y="70.0" width="330.4" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="where you learn how code fails, by being the one" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="70.0" width="394.9" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="who broke it" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="87.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="A0" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="65.5" width="23.5" height="18.5" as="geometry"/></mxCell><mxCell id="c18" value="agent edits, human approves each step" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="103.0" y="142.0" width="306.2" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="where you learn to recognise a wrong turn while" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="142.0" width="386.8" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="it is happening" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="159.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="A1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="137.5" width="23.5" height="18.5" as="geometry"/></mxCell><mxCell id="c22" value="agent completes, human reviews the diff" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="103.0" y="214.0" width="322.3" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="where you learn verification judgment — IF you" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="214.0" width="378.8" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="get ground truth about your misses" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="231.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="A2" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="209.5" width="23.5" height="18.5" as="geometry"/></mxCell><mxCell id="c26" value="sensors gate; human approves at merge" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="103.0" y="286.0" width="306.2" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="where you learn to design controls rather than" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="286.0" width="378.8" height="19.0" as="geometry"/></mxCell><mxCell id="c28" value="catch instances" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="303.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c29" value="A3" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="281.5" width="23.5" height="18.5" as="geometry"/></mxCell><mxCell id="c30" value="agent runs unprompted; human sets policy" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="103.0" y="358.0" width="330.4" height="19.0" as="geometry"/></mxCell><mxCell id="c31" value="where you learn to reason about classes of work" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="358.0" width="386.8" height="19.0" as="geometry"/></mxCell><mxCell id="c32" value="rather than instances" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="514.0" y="375.0" width="177.3" height="19.0" as="geometry"/></mxCell><mxCell id="c33" value="A4" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="353.5" width="23.5" height="18.5" as="geometry"/></mxCell><mxCell id="c34" value="Starting a junior at A2 does not accelerate them. It skips the rungs that build the judgment A2 requires." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="420.5" width="708.3" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 20.4" id="figure-20-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="227" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="95.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="95.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="145.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="TEACHING WAS RIDING FREE ON REVIEW" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="215.1" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="BEFORE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="56.4" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="▓▓▓▓▓▓▓▓▓▓▓▓ throughput" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="▒▒▒▒ teaching" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="(a by-product of the same hour)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="NOW — same capacity, double the arrivals" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="330.4" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ throughput" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="░ teaching" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="73.0" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="squeezed out, silently, by a pressure nobody attributed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="365.3" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="Apprenticeship review and throughput review cannot be done with the same hours. It must be separately budgeted." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-1.3" y="156.0" width="902.7" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 21.1" id="figure-21-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="596" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;