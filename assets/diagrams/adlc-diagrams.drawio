mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="167.0" as="sourcePoint"/><mxPoint x="450.0" y="189.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="238.0" as="sourcePoint"/><mxPoint x="450.0" y="260.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="309.0" as="sourcePoint"/><mxPoint x="450.0" y="331.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="380.0" as="sourcePoint"/><mxPoint x="450.0" y="402.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="451.0" as="sourcePoint"/><mxPoint x="450.0" y="473.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="the review queue saturates (ρ → 1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="22.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="Chapter 3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="143.0" y="44.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="REVIEW COLLAPSE — clear the queue by reading less" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="114.0" width="402.9" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="and, in parallel: cheap harness work → HARNESS THEATRE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="143.0" y="136.8" width="358.8" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="GUIDE SPRAWL — theatre accumulates, nothing is removed" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="206.0" width="443.2" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="THE SILENT SENSOR — nothing fires, and silence looks like safety" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="277.0" width="523.8" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="AUTONOMY CREEP — the gate was meaningless anyway" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="348.0" width="394.9" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="DEBT BLINDNESS — nothing detects any of it, because the fast proxies stay flat" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="419.0" width="636.7" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="AGENT WASHING — and it is reported as a successful adoption" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="490.0" width="483.5" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="A pathology, not a list. Each stage is a reasonable response to the previous one — and the last two are what prevent anyone from noticing." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="-26.2" y="527.2" width="952.5" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 21.2" id="figure-21-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="691" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="292.0" height="60.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="304.0" y="56.0" width="292.0" height="60.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="608.0" y="56.0" width="292.0" height="60.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="128.0" width="292.0" height="43.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="304.0" y="128.0" width="292.0" height="43.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="608.0" y="128.0" width="292.0" height="43.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=