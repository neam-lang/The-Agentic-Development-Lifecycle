 value="deterministic" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="85.2" width="89.4" height="16.8" as="geometry"/></mxCell><mxCell id="c18" value="CPU · ms–seconds" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="100.2" width="108.2" height="16.8" as="geometry"/></mxCell><mxCell id="c19" value="reliable" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="115.2" width="58.1" height="16.8" as="geometry"/></mxCell><mxCell id="c20" value="principles · rules" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="163.0" y="177.0" width="153.1" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="reference documentation" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="199.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="how-to guides" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="214.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c23" value="context files" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="229.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c24" value="review agents" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="544.0" y="177.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="LLM-as-judge" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="544.0" y="199.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c26" value="semantic analysis" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="544.0" y="214.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c27" value="architecture-review skills" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="544.0" y="229.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c28" value="INFERENTIAL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="172.5" width="93.2" height="18.5" as="geometry"/></mxCell><mxCell id="c29" value="probabilistic" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="192.2" width="89.4" height="16.8" as="geometry"/></mxCell><mxCell id="c30" value="model-bound · slower" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="207.2" width="133.3" height="16.8" as="geometry"/></mxCell><mxCell id="c31" value="semantically rich" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="222.2" width="114.5" height="16.8" as="geometry"/></mxCell><mxCell id="c32" value="Inferential does not mean inferior. Computational controls can only check what is expressible in code." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="273.5" width="688.3" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 7.3" id="figure-7-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="351" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="714.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=18;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="714.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="119.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="714.0" y="133.4" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=18;fillColor=#0F766E;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="714.0" y="133.4" width="102.0" height="12.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="194.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="714.0" y="207.6" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=18;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="714.0" y="207.6" width="34.0" height="12.0" as="geometry"/></mxCell><mxCell id="c10" value="SENSOR PLACEMENT — VALUE FALLS SHARPLY MOVING DOWN, BECAUSE EACH STEP SPENDS MORE OF THE CONSTRAINT" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="610.9" height="16.5" as="geometry"/></mxCell><mxCell id="c11" value="1 · BLOCKING — the action does not happen unless it passes" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="475.5" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="lint-on-edit refuses the write · the failure never enters the world" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="443.2" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="costs agent retries, which are elastic" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="2 · IN-LOOP — the agent sees the verdict and may self-correct" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="133.0" width="499.7" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="test output, type errors · costs tokens, not humans" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="155.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="3 · OUT-OF-LOOP — a human sees it later" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="208.0" width="322.3" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="CI, dashboards, weekly reports · costs the scarce resource of Chapter 3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="230.8" width="469.2" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="most organisations&#x27; sensors are here, inherited from an era when level 1 was politically impossible" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="245.8" width="651.1" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="Moving a sensor from level 3 to level 1 is a direct increase in μ — and the cheapest one available." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="283.5" width="668.3" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 7.5" id="figure-7-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="300" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=12;fillColor=#7C3AED;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="1"><mxGeometry x="270.0" y="30.0" width="48.0" height="22.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=12;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="270.0" y="80.0" width="168.0" height="22.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=12;fillColor=#0F766E;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=70" vertex="1" parent="1"><mxGeometry x="270.0" y="130.0" width="288.0" height="22.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=12;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap;opacity=95" vertex="1" parent="1"><mxGeometry x="270.0" y="180.0" width="400.0" height="22.0" as="geometry"/></mxCell><mxCell id="c5" value="COST OF POPULATING EACH CELL — AND ADOPTION TRACKS CHEAPNESS, NOT EFFECTIVENESS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="489.1" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="inferential guide — a context file" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-7.2" y="33.8" width="265.2" height="18.2" as="geometry"/></mxCell><mxCell id="c7" value="minutes" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#7C3AED;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="328.0" y="33.5" width="62.2" height="18.5" as="geometry"/></mxCell><mxCell id="c8" value="no tooling, breaks nothing, looks like progress in a PR · 90.6% adoption" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="-188.5" y="51.5" width="446.5" height="16.5" as="geometry"/></mxCell><mxCell id="c9" value="inferential sensor — a review agent" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="2.3" y="83.8" width="255.7" height="18.2" as="geometry"/></mxCell><mxCell id="c10" value="days" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="448.0" y="83.5" width="39.0" height="18.5" as="geometry"/></mxCell><mxCell id="c11" value="configure, tune the prompt, dispose of its output" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="-48.4" y="101.5" width="306.4" height="16.5" as="geometry"/></mxCell><mxCell id="c12" value="computational guide — a scaffold or codemod" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="-54.3" y="133.8" width="312.3" height="18.2" as="geometry"/></mxCell><mxCell id="c13" value="weeks" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="568.0" y="133.5" width="46.8" height="18.5" as="geometry"/></mxCell><mxCell id="c14" value="build it, integrate it, keep it current" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="12.5" y="151.5" width="245.5" height="16.5" as="geometry"/></mxCell><mxCell id="c15" value="computational sensor — a wired blocking check" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-90.4" y="183.8" width="348.4" height="18.2" as="geometry"/></mxCell><mxCell id="c16" value="a quarter + an owner" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="680.0" y="183.5" width="163.0" height="18.5" as="geometry"/></mxCell><mxCell id="c17" value="decide what to check, build, integrate, live with false positives forever · 0.9–3.2% adoption" style="text;html=1;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1" vertex="1" parent="1"><mxGeometry x="-316.4" y="201.5" width="574.4" height="16.5" as="geometry"/></mxCell><mxCell id="c18" value="Authority and durability run in the OPPOSITE direction. Nobody chose this — it is Chapter 4&#x27;s gradient acting on harness authors." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="232.5" width="868.4" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 8.1" id="figure-8-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="471" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="150.0" y="8.0" width="600.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="150.0" y="100.0" width="600.0" height="79.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="150.0" y="208.0" width="600.0" height="79.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="150.0" y="315.0" width=