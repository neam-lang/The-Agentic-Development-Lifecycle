" y="303.0" width="295.1" height="17.0" as="geometry"/></mxCell><mxCell id="c32" value="expert-owned brownfield" style="text;html=1;align=right;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="712.6" y="302.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c33" value="Every point is a real measurement. The line slopes down." style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="112.0" y="339.5" width="442.0" height="18.5" as="geometry"/></mxCell><mxCell id="c34" value="An argument that quotes one point and omits the line is not an argument — it is a selection." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="112.0" y="357.5" width="621.6" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 0.2" id="figure-0-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="363" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="43.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="636.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=18;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="636.0" y="44.0" width="7.0" height="12.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1