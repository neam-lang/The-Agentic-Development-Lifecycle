" y="66.8" width="404.3" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="↓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="14.5" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="&quot;so we can run agents at high autonomy too&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="287.3" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="░ this is Ch 21&#x27;s AUTONOMY CREEP with a case study attached ░" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="404.3" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="WHAT THEY ACTUALLY SAY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="blueprints: a deterministic pipeline around the model" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="352.3" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="pre-push hooks, sub-second, blocking, in the devbox" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="three-tier feedback" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="THEN the autonomy" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="OpenAI: layering, custom linters, standing drift agents — THEN a" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="423.7" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="million lines" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="Autonomy is the OUTPUT. The harness is the INPUT, and it was built first. Read these as an itemised bill, not as" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-5.4" y="201.0" width="910.7" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="permission." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="401.7" y="219.0" width="96.7" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 26.1" id="figure-26-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="416" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="292.0" height="60.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;ht