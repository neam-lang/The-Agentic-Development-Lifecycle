ign=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="509.0" y="33.5" width="341.2" height="18.5" as="geometry"/></mxCell><mxCell id="c10" value="GROUND" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="127.5" y="67.8" width="50.5" height="18.2" as="geometry"/></mxCell><mxCell id="c11" value="only what it can see and find" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="410.0" y="67.5" width="232.8" height="18.5" as="geometry"/></mxCell><mxCell id="c12" value="DECOMPOSE" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="106.3" y="101.8" width="71.7" height="18.2" as="geometry"/></mxCell><mxCell id="c13" value="bounded task = bounded output space" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#4338CA;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="330.0" y="101.5" width="279.2" height="18.5" as="geometry"/></mxCell><mxCell id="c14" value="GENERATE" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="109.5" y="135.8" width="68.5" height="18.2" as="geometry"/></mxCell><mxCell id="c15" value="◄ variety INJECTED — the only stochastic step" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="379.0" y="135.5" width="356.8" height="18.5" as="geometry"/></mxCell><mxCell id="c16" value="VERIFY" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#334155;resizable=1" vertex="1" parent="1"><mxGeometry x="127.5" y="169.8" width="50.5" height="18.2" as="geometry"/></mxCell><mxCell id="c17" value="sensors reject what violates constraints" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="268.0" y="169.5" width="318.0" height="18.5" as="geometry"/></mxCell><mxCell id="c18" value="INTEGRATE" style="text;html=1;align=right;verticalAlign=middle;fontSize=12.2;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="101.9" y="203.8" width="76.1" height="18.2" as="geometry"/></mxCell><mxCell id="c19" value="one artefact · deterministic · randomness consumed" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="225.0" y="203.5" width="395.5" height="18.5" as="geometry"/></mxCell><mxCell id="c20" value="Surprise at the output is a diagnostic about phases 1–3, never about the model — it sampled from the space you left open." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="236.5" width="815.1" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 12.3" id="figure-12-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="242" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" 