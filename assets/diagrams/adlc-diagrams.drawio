ontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="44.8" width="306.8" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="supervision CANNOT be reduced" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="114.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="Böckeler&#x27;s own criterion for what a good behaviour harness would buy" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="136.8" width="449.7" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="the autonomy ladder CANNOT be climbed for feature work" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="206.0" width="443.2" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="Ch 13 §13.6" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="228.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="review remains the binding constraint" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="299.0" width="306.2" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="Ch 3 §3.4" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="321.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="individual gains DO NOT aggregate" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="391.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="Ch 3 §3.8" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="413.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="One unsolved problem, four consequences — the book&#x27;s spine as a dependency chain, terminating upward in a research question." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="21.7" y="449.2" width="856.7" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Unnumbered 1 — One Source Per Concern" id="unnumbered-1-one-source-per-concern"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="530" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="95.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="135.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="209.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="283.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.5;html=1;whiteSpace=wrap;dashed=1" vertex="1" parent="1"><mxGeometry x="0.0" y="357.0" width="900.0" height="95.0" as="geometry"/></mxCell><mxCell id="c6" value="ONE SOURCE PER CONCERN, WITH THIN ADAPTERS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="263.8" height="16.5" as="geometry"/></mxCell><mxCell id="c7" value="AGENTS.md — the shared core" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="225.6" height="19.0" as="geometry"/></mxCell><mxCell id="c8" value="ALL substantive content. Tool-agnostic." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="261.3" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="&gt;60,000 projects use this format. Donated to the Linux Foundation&#x27;s" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="443.2" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="Agentic AI Foundation in December 2025." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="261.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="canonical" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="803.5" y="43.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="CLAUDE.md" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="149.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="Points at AGENTS.md. Contains ONLY what is genuinely Claude-specific." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="171.8" width="456.2" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="adapter" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="819.6" y="148.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value=".github/copilot-instructions.md" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="223.0" width="257.9" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="Points at AGENTS.md." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="245.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="adapter" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="819.6" y="222.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value=".cursor/rules/" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="297.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="Points at AGENTS.md." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="319.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="adapter" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="819.6" y="296.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="What a whole adapter should look like" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="371.0" width="306.2" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="# Claude Code" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="393.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c23" value="Read @AGENTS.md before answering. It is authoritative." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="408.8" width="358.8" height="17.2" as="geometry"/></mxCell><mxCell id="c24" value="Claude-specific: use the make check target, not npm run lint." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="424.8" width="404.3" height="17.2" as="geometry"/></mxCell><mxCell id="c25" value="Three lines. If an adapter grows past that, the content belongs in the core." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="462.5" width="514.9" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Unnumbered 2 — Guides (Feedforward)" id="unnumbered-2-guides-feedforward-"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="357" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1"