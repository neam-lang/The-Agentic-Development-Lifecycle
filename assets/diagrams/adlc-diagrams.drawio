ell><mxCell id="c40" value="harness coverage vs DRILLS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="197.0" width="217.6" height="19.0" as="geometry"/></mxCell><mxCell id="c41" value="14" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="197.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c42" value="The Silent Sensor" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="252.0" width="145.0" height="19.0" as="geometry"/></mxCell><mxCell id="c43" value="drills — deliberately produce the" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="252.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCell id="c44" value="failure" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="269.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c45" value="8" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="252.0" width="16.1" height="19.0" as="geometry"/></mxCell><mxCell id="c46" value="Guide Sprawl" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="324.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c47" value="░░ no detector exists ░░ — named as" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="317.0" y="324.0" width="290.1" height="19.0" as="geometry"/></mxCell><mxCell id="c48" value="a missing tool, not a missing" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="341.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c49" value="discipline" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="358.0" width="88.6" height="19.0" as="geometry"/></mxCell><mxCell id="c50" value="14 · 27" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="324.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c51" value="Debt Blindness" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="413.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c52" value="horizon-segregated dashboard" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="413.0" width="233.7" height="19.0" as="geometry"/></mxCell><mxCell id="c53" value="14" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="413.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c54" value="Benchmark Cargo Cult" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="468.0" width="169.2" height="19.0" as="geometry"/></mxCell><mxCell id="c55" value="&quot;what was held constant?&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="468.0" width="209.5" height="19.0" as="geometry"/></mxCell><mxCell id="c56" value="2" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="468.0" width="16.1" height="19.0" as="geometry"/></mxCell><mxCell id="c57" value="Agent Washing" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="523.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c58" value="autonomy mix" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="523.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c59" value="14" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="523.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c60" value="Prompt-and-Pray" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="578.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c61" value="the crossing checklist" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="578.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c62" value="23" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="578.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c63" value="The instruments were built for other purposes — which is evidence the model is coherent rather than fitted to its own failure modes." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="623.5" width="888.4" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 22.1" id="figure-22-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="395" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="178.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="253.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="VIBE CODING IS CORRECT WHILE ONE PERSON&#x27;S LIVE JUDGMENT IS AN ADEQUATE ACCEPTANCE TEST. IT FAILS WHEN:" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="629.2" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="the artefact is TOO LARGE to hold in view" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="338.5" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="judgment cannot cover what it cannot see" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="267.8" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="the artefact OUTLIVES the session" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="future-you is not in the room, and Ch 19 showed the work was not deeply encoded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="521.2" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="someone ELSE must maintain it" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="their standard is not yours, and yours was never written down" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.8" width="404.3" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="failures are SILENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="267.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="judgment-by-looking cannot detect what does not present · 1,471 vulnerabilities across 200 deployed apps" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="289.8" width="683.6" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="All four are properties of the CONTEXT, not of the practice — which is why the mode is right or wrong situationally." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="327.5" width="781.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 22.2" id="figure-22-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="275" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="ASHBY SAYS VARIETY MUST BE REDUCED. THERE ARE TWO PLACES TO REDUCE IT." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="434.3" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="SPECIFY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="reduce the space of ACCEPTABLE outputs" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="spec-driven development · executable contracts" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="306.8" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="COST: per TASK — recurring, linear in task count" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="319.8" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓ (never falls)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="best when: few, varied, high-stakes tasks" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="STRUCTURE + SENSE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="145.0" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="reduce the space of REACHABLE outputs" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="248.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="context · harness · graph · structure · gates" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="300.3" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="COST: per TOPOLOGY — fixed, amortised over every future task" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="397.8" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="▓▓▓▓▓▓▓▓▓▓▓▓▓░░░░░░░░░ (falls per task with volume)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="best when: many similar tasks" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="They are SUBSTITUTES at the margin. So the choice is economic — set by task volume and homogeneity — not" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="26.9" y="186.0" width="846.2" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="philosophical." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="389.6" y="204.0" width="120.8" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 22.3" id="figure-22-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="311" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rou