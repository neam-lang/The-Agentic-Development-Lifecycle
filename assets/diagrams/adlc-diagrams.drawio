" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="A3" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="417.0" y="70.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="A1 / A0" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="671.0" y="70.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="harnessability HIGH" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="65.5" width="155.2" height="18.5" as="geometry"/></mxCell><mxCell id="c18" value="9–12" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="85.2" width="33.1" height="16.8" as="geometry"/></mxCell><mxCell id="c19" value="A3" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="163.0" y="130.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="A2" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="417.0" y="130.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="A0" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="671.0" y="130.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="harnessability MEDIUM" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="125.5" width="170.8" height="18.5" as="geometry"/></mxCell><mxCell id="c23" value="5–8" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="145.2" width="26.8" height="16.8" as="geometry"/></mxCell><mxCell id="c24" value="A2" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="163.0" y="190.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="A1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="417.0" y="190.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c26" value="A0" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="671.0" y="190.0" width="24.1" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="harnessability LOW" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="185.5" width="147.5" height="18.5" as="geometry"/></mxCell><mxCell id="c28" value="0–4" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.8;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="0.0" y="205.2" width="26.8" height="16.8" as="geometry"/></mxCell><mxCell id="c29" value="No amount of harness makes severe blast radius eligible for autonomy — you must reduce the blast radius instead." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="240.5" width="755.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 13.3" id="figure-13-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="517" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="8.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="100.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="192.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="285.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="377.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="75.0" as="sourcePoint"/><mxPoint x="450.0" y="97.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="167.0" as="sourcePoint"/><mxPoint x="450.0" y="189.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="260.0" as="sourcePoint"/><mxPoint x="450.0" y="282.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="352.0" as="sourcePoint"/><mxPoint x="450.0" y="374.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="BEHAVIOUR HARNESS unsolved" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="22.0" width="217.6" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="Ch 8 §8.6–8.7" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="44.8" width="92.4" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="supervision CANNOT be reduced" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="114.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="Böckeler&#x27;s own criterion for what a good behaviour harness would buy" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="136.8" width="449.7" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="the autonomy ladder CANNOT be climbed" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="206.0" width="306.2" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="A3/A4 reachable only via near-zero blast radius or mechanical acceptance" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="228.8" width="475.7" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="review remains the binding constraint" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="299.0" width="306.2" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="Ch 3 §3.4" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="321.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="individual gains DO NOT aggregate" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="391.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="Ch 3 §3.8" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="413.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="One unsolved problem, four consequences — the book&#x27;s spine as a dependency chain, and the order the work has to be done in." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="25.1" y="449.2" width="849.8" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 13.4" id="figure-13-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="290" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="285.0" height="140.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="307.0" y="30.0" width="285.0" height="140.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="615.0" y="30.0" width="285.0" height="140.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="190.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c5" value="A BARBELL OVER BLAST RADIUS, NOT OVER AUTONOMY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="288.1" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="A4 — the convex end" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="~20–30% of work" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="downside capped by construction" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="dependency bumps · dead code · drift scans" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="staffs the outer loop (§13.7)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="A2, RE-FOUNDED" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="320.0" y="44.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="the majority" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="320.0" y="66.8" width="86.0" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="safety must rest on CONTROLS, not on" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="320.0" y="81.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="assumed review" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="320.0" y="96.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="held-out acceptance set + blocking sensors" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="320.0" y="112.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="← where Review Collapse lives if it does" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="320.0" y="127.8" width="267.8" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="not" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="320.0" y="142.8" width="27.5" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="A0 / A1 — protected" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="628.0" y="44.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="~5–10%" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="628.0" y="66.8" width="47.0" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="human authorship is the requirement" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="628.0" y="81.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="no harness buys this" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="628.0" y="96.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="the critical decile, regardless of" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="628.0" y="112.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c23" value="convenience" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="628.0" y="127.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c24" value="A2 is not the riskiest level. It is the level whose risk is most MISESTIMATED — everyone believes review is" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="14.8" y="201.0" width="870.4" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="happening." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="405.7" y="219.0" width="88.6" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 14.1" id="figure-14-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="387" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=24;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="96.0" y="292.0" width="774.0" height="51.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="ellipse;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="165.5" y="224.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="398.5" y="200.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="583.5" y="160.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="738.5" y="100.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="823.5" y="40.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=none;html=1;strokeColor=#E2E8F0;strokeWidth=1.4" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.0" y="34.0" as="sourcePoint"/><mxPoint x="96.0" y="244.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="" style="endAr