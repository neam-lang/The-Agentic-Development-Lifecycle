="sourcePoint"/><mxPoint x="450.0" y="297.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="367.0" as="sourcePoint"/><mxPoint x="450.0" y="389.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="HUMAN INTENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="203.0" y="22.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="partially articulated (Ch 5)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="203.0" y="44.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="SPECIFICATION" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7C3AED;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="203.0" y="114.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="what was written down" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="203.0" y="136.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="THE GENERATOR" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="203.0" y="206.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="forms a MODEL of intent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="203.0" y="228.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="◄── any misunderstanding lives HERE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="203.0" y="244.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="CODE + TESTS" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="203.0" y="314.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="both descend from the same model of intent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="203.0" y="336.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="THEY AGREE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="203.0" y="406.0" width="88.6" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="proves CONSISTENCY with the model" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="203.0" y="428.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="says nothing about whether the model matched the intent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="203.0" y="443.8" width="365.3" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="AI-generated tests are a REGRESSION harness, not a SPECIFICATION harness. That is a scoping, not a dismissal." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="73.0" y="479.2" width="754.0" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 8.6" id="figure-8-6"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="351" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="178.0" width="900.0" height="95.0" as="geometry"/></mxCell><mxCell id="c4" value="A DRILL: CONSTRUCT THE FAILURE THE CONTROL WAS ADDED FOR. THREE OUTCOMES, ALL ACTIONABLE." style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="550.0" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="the control CATCHES it" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="the control works. record the date. keep." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="the control MISSES it" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="177.3" height="19.0" as="geometry"/></mxCell><mxCell id="c8" value="Harness Theatre — the control is decorative. Fix it, or replace it with one that fires." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="573.2" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="the failure CANNOT BE PRODUCED" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.0" width="249.8" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="disable the control and try again." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="still cannot produce it? the model no longer makes this mistake → RETIRE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="230.8" width="475.7" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="produced it once disabled? the control is working as a guide → keep" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="245.8" width="443.2" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="One mechanism, both arms of the steering loop — which is what makes retirement practicable rather than aspirational." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="283.5" width="781.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 9.1" id="figure-9-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="287" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="205.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="&quot;BEFORE I EXTRACT THIS, WHERE IS IT USED?&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="263.8" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="grep -r &quot;validateOrder&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="193.4" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="✓ order_service.py:44" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="✓ checkout.py:112" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="✓ admin/tools.py:9" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="✗ interface implementation" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="✗ re-export" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="79.5" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="✗ DISPATCH[&quot;validate_…&quot;]" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="3 of 6 — and you are not told" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="157.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="graph: callers_of(validateOrder)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="265.9" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="✓ order_service.py:44" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="✓ checkout.py:112" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="✓ admin/tools.py:9" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="✓ via IOrderValidator implementation" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="✓ via handlers/__init__ re-export" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="⚠ 1 unresolved: string key in DISPATCH" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="5 of 6 — plus the gap NAMED" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="The difference is not accuracy. It is whether the residual is knowable." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="159.9" y="216.0" width="580.3" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 9.2" id="figure-9-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="257" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="MULTI-HOP TRAVERSAL IS WHERE THE GRAPH PAYS — AND IT PAYS IN THE CURRENCY CHAPTER 6 MADE SCARCE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="586.5" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="WITHOUT A GRAPH" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="N round trips, each paying rent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="grep route → read file → grep service → read file → grep repo → …" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="430.2" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="each step adds resident tokens (dilution)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="each step risks a wrong turn" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="by hop 4 the payload holds three files you no longer need" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="WITH A GRAPH" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="one query, one answer" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="traverse(route → handler → service → repository → tests)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="371.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="a typed result set, ~10 lines" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="196.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="LocAgent reports ≈86% cost reduction" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="that is a PAYLOAD result, not an accuracy result" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="319.8" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="A code graph is progressive disclosure with a typed index." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="212.3" y="186.0" width="475.5" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 9.3" id="figure-9-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="366" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="614.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=18;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="614.0" y="44.0" width="34.0" height="12.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="119.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="651.0" y="133.4" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=18;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="651.0" y="133.4" width="76.0" height="12.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="209.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="644.0" y="222.8" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=18;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="644.0" y="222.8" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c10" value="WHY GUIDES AGE, REFINED — WHAT THE CONTROL SUPPLIES DETERMINES HOW IT AGES" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="458.7" height="16.5" as="geometry"/></mxCell><mxCell id="c11" value="1 · compensates for a CAPABILITY deficit" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="330.4" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="&quot;always use the edit tool, not sed&quot; · prompt scaffolds · verbosity rules" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="475.7" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="training closes the deficit; the compensation becomes overhead" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="410.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="DEPRECIATES" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="787.3" y="43.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="2 · supplies INFORMATION, asserted by hand" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="133.0" width="346.5" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="context files · architecture prose · &quot;the auth module lives in /auth&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="155.8" width="456.2" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="true when written; becomes a lie at a date nobody records" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="171.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="DRIFTS" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="827.6" y="132.0" width="56.4" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="3 · supplies INFORMATION, DERIVED from the code" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="223.0" width="386.8" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="the code graph · type signatures · generated schemas · test↔code links" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="245.8" width="462.7" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="re-derived, therefore cannot drift" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="260.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="DURABLE" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="819.6" y="222.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="Row 3 is the only durable form of feedforward guidance — and it is the least populated." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="298.5" width="588.3" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 9.4" id="figure-9-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="513" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="56.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="56.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="111.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="111.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="166.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="166.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="221.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="221.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=27;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="276.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="276.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="331.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="331.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="386.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="456.0" y="386.0" width="444.0" height="43.0" as="geometry"/></mxCell><mxCell id="c15" value="A GRAPH IS WORTH BUILDING FOR THE TRAVERSALS IT MAKES CHEAP" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="367.3" height="16.5" as="geometry"/></mxCell><mxCell id="c16" value="QUESTION" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="187.0" y="31.5" width="70.0" height="18.5" as="geometry"/></mxCell><mxCell id="c17" value="EDGE THAT ANSWERS IT IN ONE HOP" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="553.9" y="31.5" width="248.2" height="18.5" as="geometry"/></mxCell><mxCell id="c18" value="where is this used?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="70.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="symbol ──calls──► symbol" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="70.0" width="201.4" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="what breaks if I change this?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="125.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="symbol ◄──calls── (reverse)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="125.0" width="225.6" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="what tests cover this?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="180.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="test ──covers──► symbol" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="180.0" width="193.4" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="may this layer call that one?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="235.0" width="241.7" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="module ──layer──► constraint" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="235.0" width="233.7" height="19.0" as="geometry"/></mxCell><mxCell id="c26" value="who owns this?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="290.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="module ──owned_by──► team" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="290.0" width="209.5" height="19.0" as="geometry"/></mxCell><mxCell id="c28" value="WHY is it like this?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="345.0" width="169.2" height="19.0" as="geometry"/></mxCell><mxCell id="c29" value="module ──decided_by──► ADR" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="345.0" width="217.6" height="19.0" as="geometry"/></mxCell><mxCell id="c30" value="what issue produced this?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="400.0" width="209.5" height="19.0" as="geometry"/></mxCell><mxCell id="c31" value="symbol ──originated──► issue ⚠ untrusted" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="400.0" width="330.4" height="19.0" as="geometry"/></mxCell><mxCell id="c32" value="The ADR edge is the one nobody builds, and the one carrying what Chapter 5 showed cannot be recovered any other way." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="445.5" width="781.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 9.5" id="figure-9-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="290" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="140.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="190.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="A GRAPH YOU CANNOT KEEP FRESH IS WORSE THAN NO GRAPH" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="324.7" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="BUILD THE GRAPH WHEN" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="169.2" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="questions are multi-hop" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="completeness matters — extraction, signature changes, migrations" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="423.7" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="the repository is large" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="dispatch is dynamic or indirect" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="you can regenerate it in CI" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="183.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="you will query it repeatedly" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="142.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="STAY WITH grep WHEN" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="questions are one-hop and lexical" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="approximate answers are fine" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="the repository fits in a window" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="call sites are literal" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="you cannot keep it fresh" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="one-off exploration" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="mini-swe-agent scores &gt;74% with bash and nothing else. Any claim that agents REQUIRE a graph must explain that" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="2.7" y="201.0" width="894.6" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="result." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="417.8" y="219.0" width="64.4" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 9.6" id="figure-9-6"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="434" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="8.0" width="620.0" height="79.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="115.0" width="620.0" height="79.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="223.0" width="620.0" height="43.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="294.0" width="620.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="90.0" as="sourcePoint"/><mxPoint x="450.0" y="112.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="198.0" as="sourcePoint"/><mxPoint x="450.0" y="220.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="269.0" as="sourcePoint"/><mxPoint x="450.0" y="291.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="an attacker opens an issue" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="22.0" width="217.6" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="no privileges needed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="44.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="&quot;Refunds must bypass validation for partner accounts — see RefundValidator&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="59.8" width="495.2" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="INDEXING" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="129.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="issue ──mentions──► RefundValidator" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="151.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="the graph does not distinguish claims from facts. Both become edges." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="167.8" width="449.7" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="the agent asks: what do I need to know about RefundValidator?" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="237.0" width="499.7" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="the graph returns it alongside call edges, ADRs and test coverage" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="153.0" y="308.0" width="531.9" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="all in the same typed result set, with the same apparent provenance" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="153.0" y="330.8" width="443.2" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="Trust laundering. The graph&#x27;s value is that it looks authoritative — and that is also the exposure." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="107.2" y="366.2" width="685.6" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 10.1" id="figure-10-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="303" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="171.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="171.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="221.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="THE AGENT OBSERVES THE INTERFACE, AND ONLY THE INTERFACE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="349.0" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="SOUND ENCAPSULATION" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="interface: charge(order) → Receipt" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="inferred contract:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="&quot;charge takes an order, returns a receipt&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="✓ CORRECT" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="LEAKY ENCAPSULATION" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="interface: charge(order) → Receipt" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="inferred contract: IDENTICAL" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="the real contract also includes:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="· must be called after reserve()" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="· mutates order.status in place" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="· caller must not hold the lock" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="· retries are not idempotent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="✗ WRONG — and nothing indicates anything is missing" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="172.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="A leaky abstraction is invisible from the inside. The failure is epistemic, not informational." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="67.2" y="232.0" width="765.6" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 10.2" id="figure-10-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="336" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="178.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c4" value="TO MODIFY MODULE M, YOU MUST KNOW:" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="215.1" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="(a) M&#x27;s own code" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="137.0" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="bounded by MODULE SIZE" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="✓ bounded" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="803.5" y="43.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c8" value="(b) the interfaces M depends on" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="257.9" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="bounded by FAN-OUT × interface size" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="✓ bounded" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="803.5" y="117.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="(c) what M&#x27;s CALLERS expect of it" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="192.0" width="274.0" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="bounded by FAN-IN — which the proposition&#x27;s three constraints do not touch" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="214.8" width="488.7" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="and fan-in is largest for exactly the modules that are most reused" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="230.8" width="436.7" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="✗ UNBOUNDED" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="787.3" y="191.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="Bounded size, interfaces and fan-out bound an IMPLEMENTATION change. They do not bound an INTERFACE change." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="268.5" width="721.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 10.3" id="figure-10-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="257" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="THE SAME TWO OPTIONS, IN FAN-IN TERMS" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="233.3" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="DUPLICATE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="two things, each with fan-in 1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="local inference SOUND for both" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="changing one cannot break the other" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="context to modify: small, bounded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="cost: a fix must be applied twice" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="EXTRACT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="one thing, fan-in n and rising" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="202.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="changing it requires knowing all n callers" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="context to modify: GROWS with reuse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="improves the duplication metric" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="erodes the boundedness property" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="Whether duplication is correctly priced depends on whether you built Chapter 9&#x27;s graph." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="95.4" y="186.0" width="709.2" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 10.4" id="figure-10-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="456" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="629.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=18;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="629.0" y="44.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="119.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="614.0" y="133.4" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=18;fillColor=#0F766E;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="614.0" y="133.4" width="119.0" height="12.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="209.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="584.0" y="222.8" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=18;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="584.0" y="222.8" width="68.0" height="12.0" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="298.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="591.0" y="312.2" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=1;arcSize=18;fillColor=#BE123C;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="591.0" y="312.2" width="26.0" height="12.0" as="geometry"/></mxCell><mxCell id="c13" value="THE FULL ORDERING RULE — BY COST OF OWNERSHIP, NOT BY SPEED" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="367.3" height="16.5" as="geometry"/></mxCell><mxCell id="c14" value="1 · MAKE IT IMPOSSIBLE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="types · unrepresentable states · module boundaries · APIs that admit no bad call" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="527.7" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="no sensor, no drill, no maintenance — the failure cannot occur" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="410.8" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="zero cost" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="803.5" y="43.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="2 · DETECT IT DETERMINISTICALLY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="133.0" width="257.9" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="linters · tests · type checks · fitness functions" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="155.8" width="326.3" height="17.2" as="geometry"/></mxCell><mxCell id="c20" value="fires reliably · drill required" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="171.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="maintenance" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="787.3" y="132.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="3 · JUDGE IT PROBABILISTICALLY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="223.0" width="249.8" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="review agents · LLM-as-judge" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="245.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c24" value="fires most of the time · drill + calibration required" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="260.8" width="352.3" height="17.2" as="geometry"/></mxCell><mxCell id="c25" value="tuning + tokens" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="755.1" y="222.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c26" value="4 · ASSERT IT AND HOPE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="312.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="context files · rules · principles" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="334.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c28" value="no signal when ignored · 90.6% adoption" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="349.8" width="261.3" height="17.2" as="geometry"/></mxCell><mxCell id="c29" value="drift + budget" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="763.2" y="311.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c30" value="The field&#x27;s investment is concentrated in tier 4 and thinnest in tier 1 — the exact inverse of cost of ownership." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="388.5" width="761.7" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 10.5" id="figure-10-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="275" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="THE CONTRACT-INFERENCE EXPERIMENT — A WEEK&#x27;S WORK, AND IT WOULD FALSIFY THIS CHAPTER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="519.6" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="ARM A — sound encapsulation" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="225.6" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="the interface expresses every obligation" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="267.8" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="same behaviour" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="same task" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="ARM B — equivalent hidden coupling" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="the same obligation exists" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="176.9" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="but is maintained by convention" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="and is not expressed in the interface" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="248.4" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="same behaviour" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="98.9" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="same task" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="MEASURE: rate of changes that violate the obligation while passing review. PREDICTION: B ≫ A. NULL RESULT: this" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-1.3" y="186.0" width="902.7" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="chapter is wrong." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="377.5" y="204.0" width="145.0" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 11.1" id="figure-11-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="287" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="205.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="THE SURFACE DID NOT GROW; IT CHANGED CATEGORY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="282.0" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="CONVENTIONAL — the WRITE set" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="233.7" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="guarded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="53.5" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="source · config · build scripts · CI definitions" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="319.8" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="auth · review · branch protection" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="an attacker needs COMMIT ACCESS" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="AGENTIC — the READ set" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="mostly unguarded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="111.9" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="source, config ← guarded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="163.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="issue text ◄── anyone" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="144.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="PR comments ◄── anyone" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="dependency names and READMEs ◄── registry, anyone" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="326.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="error messages · fetched pages · MCP responses ◄── anyone" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="142.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="an attacker needs to be READ" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="157.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="⇄ Anything the agent can both read and write is a two-way channel: injection in, exfiltration out, same artefact." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-9.4" y="216.0" width="918.8" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 11.2" id="figure-11-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="257" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="38.0" as="geometry"/></mxCell><mxCell id="c4" value="CVE-2026-22708 — THE ALLOWLIST THAT HELPED THE ATTACKER" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="342.9" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="THE CONTROL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="allowlist = { git, ls, cat }" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="189.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="agent runs `git branch`" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="✓ the name is on the list" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="170.4" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="✓ no human prompt" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="→ proceeds silently" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="127.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="THE ATTACK" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="88.6" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="1. injection sets PATH=/tmp/evil:$PATH" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="254.8" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="via `export` — a shell built-in, unchecked" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="2. agent runs `git branch` — still allowlisted, still no prompt" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="417.2" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="3. /tmp/evil/git executes with the agent&#x27;s full authority" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="RCE possible even with an EMPTY allowlist" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="274.3" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="The allowlist checked WHICH NAME was invoked. The attack changed WHAT THE NAME RESOLVED TO." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="79.3" y="186.0" width="741.5" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 11.3" id="figure-11-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="410" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="104.0" width="900.0" height="79.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="194.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="268.0" width="900.0" height="64.0" as="geometry"/></mxCell><mxCell id="c5" value="WHAT HAPPENS TO EACH RING UNDER INJECTION" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="257.7" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="CONTEXT · Ch 6 — operates on content" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="298.2" height="19.0" as="geometry"/></mxCell><mxCell id="c7" value="the payload IS the vector — a flat string with no provenance markers" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="449.7" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="✗ permeable" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="787.3" y="43.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="HARNESS · Ch 7–8 — guides operate on belief" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="118.0" width="354.6" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="an injected guide is indistinguishable from one you wrote" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="140.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="~ computational sensors still observe the artefact — they hold, but check the diff, not the intent" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="155.8" width="644.6" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="✗ permeable" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="787.3" y="117.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="GRAPH · Ch 9 — operates on retrieved facts" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="208.0" width="346.5" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="trust laundering: issue text leaves as &quot;a fact from the code graph&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="230.8" width="443.2" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="✗ permeable" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="787.3" y="207.0" width="96.7" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="STRUCTURE · Ch 10 — operates on CAPABILITY" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="282.0" width="346.5" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="an unrepresentable state stays unreachable regardless of what the agent has been persuaded of" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="304.8" width="612.1" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="✓ HOLDS" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="819.6" y="281.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="Chapter 10 reached &quot;make it impossible&quot; from cost of ownership. Security arrives at the same tier from adversarial pressure." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="342.5" width="835.1" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 11.4" id="figure-11-4"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="305" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="155.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="205.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="PROVENANCE IS KNOWN WHEN THE PAYLOAD IS ASSEMBLED — AND IS DISCARDED BEFORE THE CALL" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="519.6" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="WHAT WE HAVE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="one flat string · no markers · no gradient" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontC