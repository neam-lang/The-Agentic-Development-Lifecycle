ign=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="100.8" width="118.4" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="REVIEW" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="322.0" y="48.0" width="56.4" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="INELASTIC" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="322.0" y="70.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="fixed headcount" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="322.0" y="85.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="fixed attention" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="322.0" y="100.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="service capacity μ" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="322.0" y="116.8" width="124.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="DELIVERED" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="630.0" y="48.0" width="80.5" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="what actually ships" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="630.0" y="70.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="utilisation ρ = λ / μ · time in system W = 1 / (μ − λ)" style="text;html=1;align=center;verticalA