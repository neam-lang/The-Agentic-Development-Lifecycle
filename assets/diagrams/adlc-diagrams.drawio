tSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="151.8" width="319.8" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="INSTALL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="163.0" y="222.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c14" value="the cheapest deterministic control that detects this class" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="244.8" width="384.8" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="dated · with a named failure mode and a review date" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="259.8" width="339.3" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="◄── the loop as" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="768.0" y="218.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c17" value="published stops" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="768.0" y="234.8" width="105.4" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="here" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="768.0" y="250.8" width="34.0" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="RETIRE" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="163.0" y="329.0" width="56.4" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="disable the control. can the failure still be produced?" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="351.8" width="365.3" height="17.2" as="geometry"/></mxCell><mxCell id="c21" value="if not, remove it — the deficit has closed" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="163.0" y="366.8" width="280.8" height="17.2" as="geometry"/></mxCell><mxCell id="c22" value="Install is how the harness gains authority; retire is how it stays affordable. A loop with only the first arm terminates in theatre." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="-5.7" y="402.2" width="911.4" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 8.2" id="figure-8-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="275" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="461.0" y="30.0" width="439.0" height="125.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.6;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="175.0" width="900.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="ASHBY: REGULATOR VARIETY ≥ SYSTEM VARIETY, OR NO REGULATION" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="367.3" height="16.5" as="geometry"/></mxCell><mxCell id="c5" value="(i) GROW THE REGULATOR" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c6" value="forbidden by Ch 6&#x27;s context budget" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="66.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c7" value="forbidden by Ch 7&#x27;s cost gradient" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="81.8" width="222.4" height="17.2" as="geometry"/></mxCell><mxCell id="c8" value="forbidden by Ch 2&#x27;s depreciation" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="96.8" width="215.9" height="17.2" as="geometry"/></mxCell><mxCell id="c9" value="→ terminates in Harness Theatre" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="13.0" y="112.8" width="209.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="(ii) SHRINK THE SYSTEM" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="474.0" y="44.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="static typing — most programs unexpressible" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="66.8" width="287.3" height="17.2" as="geometry"/></mxCell><mxCell id="c12" value="opinionated frameworks" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="81.8" width="150.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="module boundaries and layering rules" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="96.8" width="241.9" height="17.2" as="geometry"/></mxCell><mxCell id="c14" value="a bounded set of service topologies" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="112.8" width="235.4" height="17.2" as="geometry"/></mxCell><mxCell id="c15" value="→ VARIETY REDUCTION" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="474.0" y="127.8" width="131.4" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="Comprehensive harnessing of an unconstrained generator is impossible in principle, not merely expensive. So" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="14.8" y="186.0" width="870.4" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="variety reduction is FORCED." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="333.2" y="204.0" width="233.7" height="19.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 8.3" id="figure-8-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="226" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id=