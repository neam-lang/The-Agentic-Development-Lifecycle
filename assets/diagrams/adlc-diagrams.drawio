" width="122.0" height="12.0" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;arcSize=27;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="0.0" y="242.0" width="900.0" height="43.0" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;arcSize=18;fillColor=#E2E8F0;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="614.0" y="256.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;arcSize=18;fillColor=#4338CA;strokeColor=none;strokeWidth=1;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="614.0" y="256.0" width="170.0" height="12.0" as="geometry"/></mxCell><mxCell id="c16" value="THE RATE-OF-CHANGE STACK — A BOOK IS WORTH WRITING ONLY WHERE HALF-LIFE EXCEEDS SHELF LIFE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="556.1" height="16.5" as="geometry"/></mxCell><mxCell id="c17" value="weeks — model checkpoints, benchmark scores" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="44.0" width="354.6" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="excluded" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="811.5" y="43.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="months — tool features, flags, file names" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="97.0" width="338.5" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="dated in text" style="text;html=1;align=right;verticalAlign