19.0" as="geometry"/></mxCell><mxCell id="c22" value="② a maintainer" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="159.0" width="120.8" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="a commit whose author differs from" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="159.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="the original author" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="176.0" width="161.1" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="git log" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="159.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c26" value="③ a secret" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="231.0" width="88.6" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="a credential reference · an env var" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="231.0" width="290.1" height="19.0" as="geometry"/></mxCell><mxCell id="c28" value="binding · a vault grant" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="248.0" width="193.4" height="19.0" as="geometry"/></mxCell><mxCell id="c29" value="secret scanning — already deployed" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="231.0" width="282.0" height="19.0" as="geometry"/></mxCell><mxCell id="c30" value="④ a schedule" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="303.0" width="104.7" height="19.0" as="geometry"/></mxCell><mxCell id="c31" value="a cron entry · a scheduled workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="303.0" width="290.1" height="19.0" as="geometry"/></mxCell><mxCell id="c32" value="· a queue subscription" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="317.0" y="320.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c33" value="a config scan" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#334155;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="621.0" y="303.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c34" value="One of the few failures in this book with a cheap, complete instrument — and nobody has built it." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="365.5" width="655.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 24.1" id="figure-24-1"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="357" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="130.0" y="8.0" width="640.0" height="43.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="130.0" y="79.0" width="640.0" height="43.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="130.0" y="150.0" width="640.0" height="43.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="130.0" y="221.0" width="640.0" height="60.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="54.0" as="sourcePoint"/><mxPoint x="450.0" y="76.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="125.0" as="sourcePoint"/><mxPoint x="450.0" y="147.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#64748B;strokeWidth=1.8" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="196.0" as="sourcePoint"/><mxPoint x="450.0" y="218.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="a codebase with NO banked variety reduction" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="22.0" width="354.6" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="its variety is MAXIMAL" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="93.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c10" value="Ashby: it needs the MOST regulation → HIGH NEED" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="164.0" width="386.8" height="19.0" as="geometry"/></mxCell><mxCell id="c11" value="nothing banked: the regulator must cover all of it, from scratch → HARDEST TO" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="235.0" width="628.6" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="BUILD" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="252.0" width="48.3" height="19.0" as="geometry"/></mxCell><mxCell id="c13" value="&quot;Most needed&quot; and &quot;hardest to build&quot; are not two facts in unfortunate combination. They are ONE property, stated twice." style="text;html=1;align=center;verticalAlign=middle;fontSize=11.8;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="38.8" y="289.2" width="822.4" height="17.8" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 24.2" id="figure-24-2"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="311" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="130.0" y="56.0" width="379.0" height="79.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="521.0" y="56.0" width="379.0" height="79.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="130.0" y="147.0" width="379.0" height="79.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="521.0" y="147.0" width="379.0" height="79.0" as="geometry"/></mxCell><mxCell id="c5" value="AGE IS A PROXY, AND A POOR ONE" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="190.7" height="16.5" as="geometry"/></mxCell><mxCell id="c6" value="LOW banked variety reduction" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="207.5" y="31.5" width="225.0" height="18.5" as="geometry"/></mxCell><mxCell id="c7" value="HIGH banked variety reduction" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="593.6" y="31.5" width="232.8" height="18.5" as="geometry"/></mxCell><mxCell id="c8" value="the common case" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="70.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c9" value="&quot;we&#x27;ll add types later&quot;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="143.0" y="92.8" width="157.4" height="17.2" as="geometry"/></mxCell><mxCell id="c10" value="░░ worst of both — and nobody warns about this quadrant ░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="143.0" y="107.8" width="384.8" height="17.2" as="geometry"/></mxCell><mxCell id="c11" value="the opportunity taken" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="534.0" y="70.0" width="177.3" height="19.0" as="geometry"/></mxCell><mxCell id="c12" value="rare, and the cheapest place to be" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="534.0" y="92.8" width="228.9" height="17.2" as="geometry"/></mxCell><mxCell id="c13" value="GREENFIELD" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="65.5" width="85.5" height="18.5" as="geometry"/></mxCell><mxCell id="c14" value="the case the inversion describes" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="143.0" y="161.0" width="265.9" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="▓▓ genuinely hard ▓▓" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="143.0" y="183.8" width="137.9" height="17.2" as="geometry"/></mxCell><mxCell id="c16" value="a disciplined monolith" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#047857;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="534.0" y="161.0" width="185.3" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="better positioned than the top-left, despite being twenty" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="534.0" y="183.8" width="378.3" height="17.2" as="geometry"/></mxCell><mxCell id="c18" value="years old" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.2;fontColor=#64748B;resizable=1" vertex="1" parent="1"><mxGeometry x="534.0" y="199.8" width="66.5" height="17.2" as="geometry"/></mxCell><mxCell id="c19" value="LEGACY" style="text;html=1;align=left;verticalAlign=middle;fontSize=12.5;fontColor=#B45309;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="0.0" y="156.5" width="54.5" height="18.5" as="geometry"/></mxCell><mxCell id="c20" value="Harnessability is banked variety reduction, and greenfield is merely the cheapest moment to bank it." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="243.5" width="675.0" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 24.3" id="figure-24-3"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="377" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=24;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=1.5;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="96.0" y="282.0" width="774.0" height="51.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="ellipse;fillColor=#047857;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="119.5" y="215.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1" vertex="1" parent="1"><mxGeometry x="351.5" y="180.5" width="15.0" height="15.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;fillColor=#B45309;strokeColor=none;strokeWidth=1;html=1" ver