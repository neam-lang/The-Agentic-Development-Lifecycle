=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="276.0" height="16.5" as="geometry"/></mxCell><mxCell id="c12" value="INNER LOOP PRODUCES" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="144.4" y="31.5" width="155.2" height="18.5" as="geometry"/></mxCell><mxCell id="c13" value="OUTER LOOP CONSUMES" style="text;html=1;align=center;verticalAlign=middle;fontSize=12.5;fontColor=#0F172A;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="600.4" y="31.5" width="155.2" height="18.5" as="geometry"/></mxCell><mxCell id="c14" value="retrieval trace" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="70.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c15" value="was this starvation or dilution? (Ch 6 §6.3)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="70.0" width="362.6" height="19.0" as="geometry"/></mxCell><mxCell id="c16" value="execution trace" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="125.0" width="128.9" height="19.0" as="geometry"/></mxCell><mxCell id="c17" value="where did it go wrong, and when? (Ch 2: agents fail" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="125.0" width="419.1" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="slowly)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="142.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c19" value="sensor report" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="197.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="which sensors fired? which never do? (Ch 8: the silent" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="197.0" width="443.2" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="sensor)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="214.0" width="64.4" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="escalation" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4338CA;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="13.0" y="269.0" width="88.6" height="19.0" as="geometry"/></mxCell><mxCell id="c23" value="was the agent right to stop? (Ch 14: escalation" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="269.0" width="386.8" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="quality)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0F766E;resizable=1;fontStyle=1" vertex="1" parent="1"><mxGeometry x="469.0" y="286.0" width="72.5" height="19.0" as="geometry"/></mxCell><mxCell id="c25" value="░░ NO ARTEFACTS ░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="13.0" y="341.0" width="153.1" height="19.0" as="geometry"/></mxCell><mxCell id="c26" value="░░ NOTHING ░░" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#BE123C;resizable=1;fontStyle=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="469.0" y="341.0" width="112.8" height="19.0" as="geometry"/></mxCell><mxCell id="c27" value="A lifecycle without artefacts has no outer loop. Not a weak one — none." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#64748B;resizable=1;fontStyle=2" vertex="1" parent="1"><mxGeometry x="0.0" y="386.5" width="481.6" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Figure 12.5" id="figure-12-5"><mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="341" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=27;fillColor=#FFF1F2;strokeColor=#BE123C;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="56.0" width="374.0" height="110.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=27;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=2.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="526.0" y="56.0" width="374.0" height="110.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=27;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="140.0" y="178.0" width="374.0" height="79.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=27;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.4;html=1;whiteSpace=wrap" vertex="1" parent="1"><mxGeometry x="526.0" y="178.0" width="374.0" height="79.0" as="geometry"/></mxCell><mxCell id="c5" value="TWO ORTHOGONAL LADDERS — SPECIFICATION STRENGTH × AGENT AUTHORITY" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.5;fontColor=#94A3B8;resizable=1;fontFamily=Courier New" vertex="1" parent="1"><mxGeometry x="0.0" y="1.5" width="403.8" height